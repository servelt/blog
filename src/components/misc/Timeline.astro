---
type Entry = {
  title?: unknown;
  subtitle?: string;
  period?: string;
  color?: "green" | "yellow" | "gray";
};

const { entries = [] } = Astro.props as { entries: Entry[] };
---

<div class="tl">
  {entries.map((e) => (
    <div class={`row ${e.color ?? "gray"}`}>
      <div class="rail">
        <div class="dot"></div>
        <div class="line"></div>
      </div>

      <div class="body">
        <div class="title">{e.title}</div>
        {e.subtitle ? <div class="sub">{e.subtitle}</div> : null}
        {e.period ? <div class="period">{e.period}</div> : null}
      </div>
    </div>
  ))}
</div>

<style>
  .tl { display:flex; flex-direction:column; gap:18px; margin-top:12px; }
  .row { display:flex; gap:14px; }

  .rail { width:14px; display:flex; flex-direction:column; align-items:center; }
  .dot {
    width:10px; height:10px; border-radius:999px;
    background: rgba(255,255,255,.35);
    margin-top:4px;
  }
  .line {
    width:4px; flex:1; border-radius:999px;
    background: rgba(255,255,255,.12);
    margin-top:8px;
  }

  .row.green .dot, .row.green .line { background: #49d17a; }
  .row.yellow .dot, .row.yellow .line { background: #f3c969; }
  .row.gray .dot { background: rgba(255,255,255,.35); }
  .row.gray .line { background: rgba(255,255,255,.12); }

  .title { font-weight: 850; }
  .sub { opacity:.8; margin-top:4px; }
  .period { opacity:.6; margin-top:6px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
</style>
