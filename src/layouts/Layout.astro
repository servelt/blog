let aboutMotionCleanup: (() => void) | null = null;

function initAboutMotion() {
	if (aboutMotionCleanup) {
		aboutMotionCleanup();
		aboutMotionCleanup = null;
	}

	const root = document.documentElement;
	const page = document.querySelector('.about-page') as HTMLElement | null;
	const mainbox = document.querySelector('.about-mainbox') as HTMLElement | null;
	const avatar = mainbox?.querySelector('.about-avatar') as HTMLElement | null;
	const copy = mainbox?.querySelector('.about-copy') as HTMLElement | null;
	const content = document.querySelector('.about-content') as HTMLElement | null;
	const liveStack = document.querySelector('.about-live-stack') as HTMLElement | null;
	const achievements = document.querySelector('.about-achievements') as HTMLElement | null;
	root.classList.toggle('about-motion-page', !!page);
	root.classList.remove('about-js-motion-ready');
	root.classList.remove('about-scroll-jacking');
	root.classList.remove('about-motion-running');
	root.classList.remove('about-motion-complete');
	if (!page || !mainbox || !avatar || !copy || !content || !liveStack || !achievements) return;

	const reduceMotion = false;
	const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);
	const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3);
	const easeInOutCubic = (value: number) =>
		value < 0.5 ? 4 * value * value * value : 1 - Math.pow(-2 * value + 2, 3) / 2;
	let frame = 0;
	let introCurrentScroll = 0;
	let introTargetScroll = 0;
	let introScrollVelocity = 0;
	let introDone = reduceMotion;
	let introDistance = 1200;
	let introAutoActive = false;
	let introAutoFromScroll = 0;
	let introAutoToScroll = 0;
	let introAutoStartTime = 0;
	let introAutoDuration = 0;
	let lastLeakedScrollTop = 0;
	let lastTouchY: number | null = null;
	const bodyScrollInstance = document.body ? OverlayScrollbars(document.body) : undefined;
	const bodyScrollElements = bodyScrollInstance?.elements();
	const scrollOffsetElement =
		bodyScrollElements?.scrollOffsetElement ||
		document.scrollingElement ||
		document.documentElement;
	const scrollEventElement = bodyScrollElements?.scrollEventElement || document;
	const scrollLockElements = Array.from(new Set(
		[
			document.documentElement,
			document.body,
			scrollOffsetElement,
			bodyScrollElements?.viewport,
			bodyScrollElements?.content,
		].filter((element): element is HTMLElement => element instanceof HTMLElement),
	));
	const storedScrollLocks = new Map<HTMLElement, Partial<CSSStyleDeclaration>>();
	const handledInputEvents = new WeakSet<Event>();
	const readScrollTop = () => {
		const values = [
			window.scrollY,
			window.pageYOffset,
			document.documentElement.scrollTop,
			document.body?.scrollTop,
			scrollOffsetElement?.scrollTop,
			bodyScrollElements?.viewport?.scrollTop,
			bodyScrollElements?.content?.scrollTop,
		];

		return values.reduce<number>((max, value) => {
			const numericValue = Number(value);
			return Number.isFinite(numericValue) ? Math.max(max, numericValue) : max;
		}, 0);
	};
	const writeScrollTop = (value: number) => {
		if (scrollOffsetElement) scrollOffsetElement.scrollTop = value;
		if (bodyScrollElements?.viewport) bodyScrollElements.viewport.scrollTop = value;
		if (document.scrollingElement) document.scrollingElement.scrollTop = value;
		document.documentElement.scrollTop = value;
		if (document.body) document.body.scrollTop = value;
		window.scrollTo({ top: value, left: 0, behavior: 'auto' });
	};
	const markInputEvent = (event: Event) => {
		if (handledInputEvents.has(event)) return false;
		handledInputEvents.add(event);
		return true;
	};
	const setScrollContainerLock = (locked: boolean) => {
		scrollLockElements.forEach((element) => {
			if (locked) {
				if (!storedScrollLocks.has(element)) {
					storedScrollLocks.set(element, {
						overflow: element.style.overflow,
						overflowX: element.style.overflowX,
						overflowY: element.style.overflowY,
						overscrollBehavior: element.style.overscrollBehavior,
						touchAction: element.style.touchAction,
					});
				}
				element.style.overflow = 'hidden';
				element.style.overflowX = 'hidden';
				element.style.overflowY = 'hidden';
				element.style.overscrollBehavior = 'none';
				element.style.touchAction = 'none';
				return;
			}

			const previous = storedScrollLocks.get(element);
			if (!previous) return;
			element.style.overflow = previous.overflow || '';
			element.style.overflowX = previous.overflowX || '';
			element.style.overflowY = previous.overflowY || '';
			element.style.overscrollBehavior = previous.overscrollBehavior || '';
			element.style.touchAction = previous.touchAction || '';
			storedScrollLocks.delete(element);
		});
	};
	const timelineItems = Array.from(content.querySelectorAll('.about-stats, .about-intro-card, .about-timeline-section, .about-achievements h2, .about-achievements .row')) as HTMLElement[];
	const revealedTimelineProgress = new WeakMap<HTMLElement, number>();

	const getMaxPageWidth = () => {
		const rootStyle = window.getComputedStyle(document.documentElement);
		const rootFontSize = parseFloat(rootStyle.fontSize) || 16;
		const pageWidthRem = parseFloat(rootStyle.getPropertyValue('--page-width')) || 75;
		return pageWidthRem * rootFontSize;
	};

	const setMotionMode = () => {
		const isRunning = !introDone && !reduceMotion;
		root.classList.toggle('about-scroll-jacking', isRunning);
		root.classList.toggle('about-motion-running', isRunning);
		root.classList.toggle('about-motion-complete', !isRunning);
		setScrollContainerLock(isRunning);
	};

	const resetLiveItems = () => {
		timelineItems.forEach((item) => {
			item.style.removeProperty("opacity");
			item.style.removeProperty("transform");
			item.style.removeProperty("filter");
		});
		[
			'--about-main-left',
			'--about-main-top',
			'--about-main-width',
			'--about-main-height',
			'--about-main-radius',
			'--about-main-padding',
			'--about-main-tilt',
			'--about-main-scale',
			'--about-main-glow-opacity',
			'--about-main-glow-scale',
			'--about-content-width',
			'--about-content-top',
			'--about-content-opacity',
			'--about-content-y',
			'--about-live-left',
			'--about-live-top',
			'--about-live-width',
			'--about-live-height',
			'--about-live-opacity',
			'--about-live-y',
			'--about-live-scale',
			].forEach((name) => page.style.removeProperty(name));
		content.style.removeProperty('pointer-events');
		content.style.removeProperty('visibility');
		avatar.style.removeProperty('--about-avatar-x');
		avatar.style.removeProperty('--about-avatar-y');
		avatar.style.removeProperty('--about-avatar-scale');
		avatar.style.removeProperty('--about-avatar-rx');
		avatar.style.removeProperty('--about-avatar-ry');
		copy.style.removeProperty('--about-copy-x');
		copy.style.removeProperty('--about-copy-y');
		copy.style.removeProperty('--about-copy-scale');
		setScrollContainerLock(false);
		root.classList.remove('about-motion-page');
		root.classList.remove('about-js-motion-ready');
		root.classList.remove('about-scroll-jacking');
		root.classList.remove('about-motion-running');
		root.classList.remove('about-motion-complete');
	};

	const setLiveItemState = (item: HTMLElement, progress: number, index: number, persist = true) => {
		const previousProgress = persist ? revealedTimelineProgress.get(item) ?? 0 : 0;
		const stableProgress = clamp(Math.max(progress, previousProgress), 0, 1);
		if (persist) {
			revealedTimelineProgress.set(item, stableProgress);
		}
		const eased = easeOutCubic(stableProgress);
		const driftY = (1 - eased) * 28;
		const driftX = (index % 2 === 0 ? -3 : 3) * (1 - eased);
		const rotate = (index % 2 === 0 ? -0.65 : 0.65) * (1 - eased);
		const scale = 0.97 + eased * 0.03;
		item.style.opacity = eased.toFixed(3);
		item.style.transform = `translate3d(${driftX.toFixed(2)}px, ${driftY.toFixed(2)}px, 0) scale(${scale.toFixed(3)}) rotateX(${rotate.toFixed(2)}deg)`;
		item.style.filter = `blur(${((1 - eased) * 6).toFixed(2)}px)`;
	};

	timelineItems.forEach((item) => {
		item.style.opacity = "0";
		item.style.transform = "translate3d(0, 2.2rem, 0) scale(0.97) rotateX(3deg)";
		item.style.filter = "blur(10px)";
	});

	const updateTimelineRows = (revealProgress: number) => {
		if (reduceMotion) {
			timelineItems.forEach((item) => {
				revealedTimelineProgress.set(item, 1);
				item.style.opacity = "1";
				item.style.transform = "translate3d(0, 0, 0) scale(1)";
				item.style.filter = "blur(0)";
			});
			return;
		}

		if (!introDone) {
			timelineItems.forEach((item, index) => {
				const delay = Math.min(index * 0.018, 0.22);
				const progress = clamp((revealProgress - delay) / 0.5, 0, 1);
				setLiveItemState(item, progress, index, false);
			});
			return;
		}

		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 1.08;
		const endLine = viewportHeight * 0.8;

		timelineItems.forEach((item, index) => {
			const rect = item.getBoundingClientRect();
			const baseRaw = clamp((startLine - rect.top) / Math.max(1, startLine - endLine), 0, 1);
			const delay = Math.min(index * 0.0025, 0.035);
			const progress = clamp((baseRaw - delay) / 0.28, 0, 1);
			setLiveItemState(item, progress, index);
		});
	};

	const settleIntroIfComplete = () => {
		if (introTargetScroll >= introDistance - 1 && introCurrentScroll >= introDistance - 1.25) {
			introTargetScroll = introDistance;
			introCurrentScroll = introDistance;
			introScrollVelocity = 0;
			introAutoActive = false;
			introDone = true;
			lastLeakedScrollTop = 0;
			lastTouchY = null;
			writeScrollTop(0);
			return true;
		}

		return false;
	};

	const smoothIntroProgress = () => {
		if (reduceMotion || introDone || introAutoActive) return false;

		const diff = introTargetScroll - introCurrentScroll;
		introScrollVelocity = (introScrollVelocity + diff * 0.082) * 0.88;
		if (Math.abs(diff) < 0.45 && Math.abs(introScrollVelocity) < 0.45) {
			introCurrentScroll = introTargetScroll;
		} else {
			introCurrentScroll = clamp(introCurrentScroll + introScrollVelocity, 0, introDistance);
		}

		settleIntroIfComplete();
		return Math.abs(introTargetScroll - introCurrentScroll) > 0.45 || Math.abs(introScrollVelocity) > 0.45;
	};

	const startIntroAutoScroll = (deltaY: number) => {
		const direction = Math.sign(deltaY);
		if (reduceMotion || introDone || !direction) {
			requestMotionUpdate();
			return false;
		}

		const destination = direction > 0 ? introDistance : 0;
		if (introAutoActive && Math.abs(introAutoToScroll - destination) < 1) {
			requestMotionUpdate();
			return true;
		}

		if (Math.abs(destination - introCurrentScroll) < 2) {
			requestMotionUpdate();
			return false;
		}

		introAutoFromScroll = introCurrentScroll;
		introAutoToScroll = destination;
		introAutoStartTime = performance.now();
		const distanceRatio = clamp(
			Math.abs(introAutoToScroll - introAutoFromScroll) / Math.max(1, introDistance),
			0,
			1,
		);
		introAutoDuration = clamp(760 + distanceRatio * 900, 860, 1660);
		introTargetScroll = destination;
		introScrollVelocity = 0;
		introAutoActive = true;
		requestMotionUpdate();
		return true;
	};

	const advanceIntroAutoScroll = () => {
		if (!introAutoActive || reduceMotion || introDone) return false;

		const elapsed = performance.now() - introAutoStartTime;
		const progress = clamp(elapsed / Math.max(1, introAutoDuration), 0, 1);
		const eased = easeInOutCubic(progress);
		introCurrentScroll = clamp(
			introAutoFromScroll + (introAutoToScroll - introAutoFromScroll) * eased,
			0,
			introDistance,
		);
		introTargetScroll = introAutoToScroll;
		introScrollVelocity = 0;

		if (progress >= 1) {
			introCurrentScroll = introAutoToScroll;
			introAutoActive = false;
			settleIntroIfComplete();
			return false;
		}

		return true;
	};

	const absorbLeakedNativeScroll = () => {
		if (reduceMotion || introDone) return false;

		const leakedScrollTop = readScrollTop();
		if (leakedScrollTop <= 1) {
			lastLeakedScrollTop = 0;
			return false;
		}

		const nativeDelta =
			lastLeakedScrollTop <= 1 ? leakedScrollTop : leakedScrollTop - lastLeakedScrollTop;
		lastLeakedScrollTop = leakedScrollTop;
		writeScrollTop(0);

		if (Math.abs(nativeDelta) < 0.5) return false;

		return startIntroAutoScroll(nativeDelta);
	};

	const updateMotion = () => {
		frame = 0;
		const viewportHeight = window.innerHeight;
		const viewportWidth = window.innerWidth;
		const isNarrow = viewportWidth <= 900;
		const sidePadding = isNarrow ? 12 : 24;
		const compactWidth = Math.min(getMaxPageWidth(), viewportWidth - sidePadding * 2);
		const compactLeft = Math.max(0, (viewportWidth - compactWidth) / 2);
		const compactTop = isNarrow ? 72 : 82;
		const compactHeight = isNarrow ? clamp(viewportHeight * 0.5, 390, 500) : 236;
		const liveGap = isNarrow ? 10 : 12;
		introDistance = Math.max(viewportHeight * 1.42, isNarrow ? 980 : 1240);
		introCurrentScroll = clamp(introCurrentScroll, 0, introDistance);
		introTargetScroll = clamp(introTargetScroll, 0, introDistance);
		const autoScrollActive = advanceIntroAutoScroll();
		const absorbedNativeScroll = autoScrollActive ? false : absorbLeakedNativeScroll();
		const shouldContinueIntro = autoScrollActive || absorbedNativeScroll || smoothIntroProgress();
		setMotionMode();
		page.style.setProperty('--about-content-width', `${compactWidth.toFixed(2)}px`);
		page.style.setProperty('--about-content-top', `${compactTop.toFixed(2)}px`);

		if (!introDone && Math.abs(readScrollTop()) > 1) {
			writeScrollTop(0);
		}

		const mainRawProgress = reduceMotion ? 1 : clamp(introCurrentScroll / Math.max(1, introDistance), 0, 1);
		const mainProgress = reduceMotion ? 1 : easeOutCubic(mainRawProgress);
		const intro = 1 - mainProgress;
		const revealRawProgress = reduceMotion ? 1 : clamp((mainRawProgress - 0.12) / 0.58, 0, 1);
		const revealProgress = easeOutCubic(revealRawProgress);
		const contentProgress = reduceMotion || introDone ? 1 : clamp((mainRawProgress - 0.78) / 0.22, 0, 1);
		const mainTop = compactTop * mainProgress;
		const mainLeft = compactLeft * mainProgress;
		const mainWidth = viewportWidth + (compactWidth - viewportWidth) * mainProgress;
		const mainHeight = viewportHeight + (compactHeight - viewportHeight) * mainProgress;
		const mainRadius = mainProgress * 0.95;
		const mainPadding = isNarrow ? 1.15 + intro * 0.9 : 1.65 + intro * 2.85;
		const livePreviewTop = mainTop + mainHeight + liveGap;
		const previewHeight = Math.max(1, viewportHeight - livePreviewTop - (isNarrow ? 8 : 14));

		page.style.setProperty('--about-main-left', `${mainLeft.toFixed(2)}px`);
		page.style.setProperty('--about-main-top', `${mainTop.toFixed(2)}px`);
		page.style.setProperty('--about-main-width', `${mainWidth.toFixed(2)}px`);
		page.style.setProperty('--about-main-height', `${mainHeight.toFixed(2)}px`);
		page.style.setProperty('--about-main-radius', `${mainRadius.toFixed(2)}rem`);
		page.style.setProperty('--about-main-padding', `${mainPadding.toFixed(2)}rem`);
		page.style.setProperty('--about-main-tilt', `${(intro * -1.35).toFixed(2)}deg`);
		page.style.setProperty('--about-main-scale', `${(1 + intro * 0.008).toFixed(3)}`);
		page.style.setProperty('--about-main-glow-opacity', `${(0.28 + intro * 0.58).toFixed(3)}`);
		page.style.setProperty('--about-main-glow-scale', `${(0.72 + intro * 0.4).toFixed(3)}`);
		page.style.setProperty('--about-live-left', `${compactLeft.toFixed(2)}px`);
		page.style.setProperty('--about-live-top', `${livePreviewTop.toFixed(2)}px`);
		page.style.setProperty('--about-live-width', `${compactWidth.toFixed(2)}px`);
		page.style.setProperty('--about-live-height', `${previewHeight.toFixed(2)}px`);
		page.style.setProperty('--about-live-opacity', `${(introDone ? 1 : revealProgress).toFixed(3)}`);
		page.style.setProperty('--about-live-y', `${((1 - revealProgress) * 42).toFixed(2)}px`);
		page.style.setProperty('--about-live-scale', `${(0.94 + revealProgress * 0.06).toFixed(3)}`);
		page.style.setProperty('--about-content-opacity', contentProgress.toFixed(3));
		page.style.setProperty('--about-content-y', `${((1 - contentProgress) * 54).toFixed(2)}px`);
		content.style.pointerEvents = introDone ? '' : 'none';
		content.style.visibility = '';
		mainbox.classList.toggle('is-expanded', mainProgress < 0.72 || isNarrow);

		if (isNarrow || reduceMotion) {
			avatar.style.setProperty('--about-avatar-x', '0px');
			avatar.style.setProperty('--about-avatar-y', '0px');
			avatar.style.setProperty('--about-avatar-scale', (1 + intro * 0.18).toFixed(3));
			avatar.style.setProperty('--about-avatar-rx', '0deg');
			avatar.style.setProperty('--about-avatar-ry', '0deg');
			copy.style.setProperty('--about-copy-x', '0px');
			copy.style.setProperty('--about-copy-y', '0px');
			copy.style.setProperty('--about-copy-scale', '1');
			updateTimelineRows(revealProgress);
			if (shouldContinueIntro) {
				requestMotionUpdate();
			}
			return;
		}

		const targetAvatarX = mainbox.clientWidth / 2;
		const targetAvatarY = mainbox.clientHeight * 0.37;
		const normalAvatarX = avatar.offsetLeft + avatar.offsetWidth / 2;
		const normalAvatarY = avatar.offsetTop + avatar.offsetHeight / 2;
		const avatarX = (targetAvatarX - normalAvatarX) * intro;
		const avatarY = (targetAvatarY - normalAvatarY) * intro;

		const targetCopyX = mainbox.clientWidth / 2;
		const targetCopyY = targetAvatarY + avatar.offsetHeight * (1.02 + intro * 0.08);
		const normalCopyX = copy.offsetLeft + copy.offsetWidth / 2;
		const normalCopyY = copy.offsetTop + copy.offsetHeight / 2;
		const copyX = (targetCopyX - normalCopyX) * intro;
		const copyY = (targetCopyY - normalCopyY) * intro;

		avatar.style.setProperty('--about-avatar-x', `${avatarX.toFixed(2)}px`);
		avatar.style.setProperty('--about-avatar-y', `${avatarY.toFixed(2)}px`);
		avatar.style.setProperty('--about-avatar-scale', (1 + intro * 0.36).toFixed(3));
		avatar.style.setProperty('--about-avatar-rx', `${(intro * 2.4).toFixed(2)}deg`);
		avatar.style.setProperty('--about-avatar-ry', `${(intro * -4.6).toFixed(2)}deg`);
		copy.style.setProperty('--about-copy-x', `${copyX.toFixed(2)}px`);
		copy.style.setProperty('--about-copy-y', `${copyY.toFixed(2)}px`);
		copy.style.setProperty('--about-copy-scale', (1 + intro * 0.032).toFixed(3));
		updateTimelineRows(revealProgress);
		if (shouldContinueIntro) {
			requestMotionUpdate();
		}
	};

	const requestMotionUpdate = () => {
		if (frame) return;
		frame = window.requestAnimationFrame(updateMotion);
	};

	const pushIntroScroll = (deltaY: number) => {
		if (reduceMotion || introDone || !Number.isFinite(deltaY) || Math.abs(deltaY) < 0.5) {
			requestMotionUpdate();
			return false;
		}

		lastLeakedScrollTop = 0;
		return startIntroAutoScroll(deltaY);
	};

	const handleWheelMotion = (event: WheelEvent) => {
		if (introDone || reduceMotion) return;
		if (!markInputEvent(event)) return;
		event.preventDefault();
		event.stopPropagation();
		event.stopImmediatePropagation();
		const unit = event.deltaMode === 1 ? 40 : event.deltaMode === 2 ? window.innerHeight : 1;
		pushIntroScroll(event.deltaY * unit);
	};

	const handleTouchStartMotion = (event: TouchEvent) => {
		if (introDone || reduceMotion) return;
		lastTouchY = event.touches[0]?.clientY ?? null;
	};

	const handleTouchMoveMotion = (event: TouchEvent) => {
		if (introDone || reduceMotion) return;
		if (!markInputEvent(event)) return;
		const currentY = event.touches[0]?.clientY ?? null;
		if (currentY === null || lastTouchY === null) {
			lastTouchY = currentY;
			requestMotionUpdate();
			return;
		}

		event.preventDefault();
		event.stopPropagation();
		event.stopImmediatePropagation();
		pushIntroScroll(lastTouchY - currentY);
		lastTouchY = currentY;
	};

	const handleKeyMotion = (event: KeyboardEvent) => {
		if (introDone || reduceMotion) return;
		const keyDeltas: Record<string, number> = {
			ArrowDown: 72,
			PageDown: window.innerHeight * 0.32,
			" ": window.innerHeight * 0.32,
			ArrowUp: -72,
			PageUp: -window.innerHeight * 0.32,
			Home: -introDistance,
			End: introDistance,
		};
		const delta = keyDeltas[event.key];
		if (delta === undefined) {
			requestMotionUpdate();
			return;
		}

		event.preventDefault();
		pushIntroScroll(delta);
	};

	const motionListenerCleanups: Array<() => void> = [];
	const addMotionListener = (
		target: EventTarget | null | undefined,
		eventName: string,
		options?: AddEventListenerOptions | boolean,
		handler: EventListener = requestMotionUpdate,
	) => {
		if (!target) return;
		target.addEventListener(eventName, handler, options);
		motionListenerCleanups.push(() => target.removeEventListener(eventName, handler, options));
	};

	if (!reduceMotion) {
		writeScrollTop(0);
	}
	setMotionMode();
	updateMotion();
	window.requestAnimationFrame(() => {
		if (!introDone && !reduceMotion) {
			writeScrollTop(0);
			requestMotionUpdate();
		}
	});
	root.classList.add('about-js-motion-ready');
	addMotionListener(window, 'scroll', { passive: true });
	addMotionListener(document, 'scroll', { passive: true, capture: true });
	addMotionListener(document.documentElement, 'scroll', { passive: true });
	addMotionListener(document.body, 'scroll', { passive: true });
	addMotionListener(scrollOffsetElement, 'scroll', { passive: true });
	addMotionListener(scrollEventElement, 'scroll', { passive: true });
	addMotionListener(bodyScrollElements?.viewport, 'scroll', { passive: true });
	addMotionListener(window, 'wheel', { passive: false, capture: true }, handleWheelMotion as EventListener);
	addMotionListener(document, 'wheel', { passive: false, capture: true }, handleWheelMotion as EventListener);
	addMotionListener(document.documentElement, 'wheel', { passive: false, capture: true }, handleWheelMotion as EventListener);
	addMotionListener(document.body, 'wheel', { passive: false, capture: true }, handleWheelMotion as EventListener);
	addMotionListener(scrollOffsetElement, 'wheel', { passive: false, capture: true }, handleWheelMotion as EventListener);
	addMotionListener(scrollEventElement, 'wheel', { passive: false, capture: true }, handleWheelMotion as EventListener);
	addMotionListener(bodyScrollElements?.viewport, 'wheel', { passive: false, capture: true }, handleWheelMotion as EventListener);
	addMotionListener(window, 'touchstart', { passive: true }, handleTouchStartMotion as EventListener);
	addMotionListener(window, 'touchmove', { passive: false, capture: true }, handleTouchMoveMotion as EventListener);
	addMotionListener(document, 'touchmove', { passive: false, capture: true }, handleTouchMoveMotion as EventListener);
	addMotionListener(document.documentElement, 'touchmove', { passive: false, capture: true }, handleTouchMoveMotion as EventListener);
	addMotionListener(document.body, 'touchmove', { passive: false, capture: true }, handleTouchMoveMotion as EventListener);
	addMotionListener(scrollOffsetElement, 'touchmove', { passive: false, capture: true }, handleTouchMoveMotion as EventListener);
	addMotionListener(scrollEventElement, 'touchmove', { passive: false, capture: true }, handleTouchMoveMotion as EventListener);
	addMotionListener(bodyScrollElements?.viewport, 'touchmove', { passive: false, capture: true }, handleTouchMoveMotion as EventListener);
	addMotionListener(window, 'keydown', undefined, handleKeyMotion as EventListener);
	addMotionListener(window, 'resize');
	const motionPoll = window.setInterval(requestMotionUpdate, 120);

	aboutMotionCleanup = () => {
		if (frame) window.cancelAnimationFrame(frame);
		window.clearInterval(motionPoll);
		motionListenerCleanups.forEach((cleanup) => cleanup());
		resetLiveItems();
	};
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	initCustomScrollbar();
	initAboutMotion();
	showBanner();
}

/* Load settings when entering the site */
init();

const setup = () => {
	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!bannerEnabled) {
			return
		}
		let threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		let navbar = document.getElementById('navbar-wrapper')
		if (!navbar || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('content:replace', () => {
		initCustomScrollbar();
		initAboutMotion();
	})
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		try {
			sessionStorage.removeItem("__serveltInternalNavigation");
		} catch {}
		initAboutMotion();

		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		try {
			sessionStorage.removeItem("__serveltInternalNavigation");
		} catch {}

		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const toc = document.getElementById('toc-wrapper');
            if (toc) {
                toc.classList.remove('toc-not-ready')
            }
        }, 200)
	});
}
	let swupHookSetupDone = false;
	const setupWhenSwupReady = () => {
		if (swupHookSetupDone) return true;
		if (!window?.swup?.hooks) return false;
		swupHookSetupDone = true;
		setup();
		return true;
	};

	if (!setupWhenSwupReady()) {
		let attempts = 0;
		const waitForSwup = () => {
			if (setupWhenSwupReady()) {
				document.removeEventListener('astro:page-load', waitForSwup);
				return;
			}
			if (attempts++ < 160) {
				window.setTimeout(waitForSwup, 50);
			}
		};
		document.addEventListener('astro:page-load', waitForSwup);
		waitForSwup();
	}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let navbar = document.getElementById('navbar-wrapper')
function scrollFunction() {
	let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)

	if (backToTopBtn) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}

	if (bannerEnabled && toc) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			toc.classList.remove('toc-hide')
		} else {
			toc.classList.add('toc-hide')
		}
	}

	if (!bannerEnabled) return
	if (navbar) {
		const NAVBAR_HEIGHT = 72
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16			// The height the main panel overlaps the banner

		let bannerHeight = BANNER_HEIGHT
		if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
			bannerHeight = BANNER_HEIGHT_HOME
		}
		let threshold = window.innerHeight * (bannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		} else {
			navbar.classList.remove('navbar-hidden')
		}
	}
}
window.onscroll = scrollFunction

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

	let photoSwipeSwupSetupDone = false;
	const setupPhotoSwipeWhenSwupReady = () => {
		if (photoSwipeSwupSetupDone) return true;
		if (!window.swup?.hooks) return false;
		photoSwipeSwupSetupDone = true;
		setup();
		return true;
	};

	if (!setupPhotoSwipeWhenSwupReady()) {
		let attempts = 0;
		const waitForSwup = () => {
			if (setupPhotoSwipeWhenSwupReady()) {
				document.removeEventListener("astro:page-load", waitForSwup);
				return;
			}
			if (attempts++ < 160) {
				window.setTimeout(waitForSwup, 50);
			}
		};
		document.addEventListener("astro:page-load", waitForSwup);
		waitForSwup();
	}
	</script>
