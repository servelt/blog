---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "../styles/variables.styl";
import "../styles/global.css";
import "../styles/markdown-extend.styl";
import "../styles/site-entry-3d-fix.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { profileConfig, siteConfig } from "@/config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DARK_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			localStorage.setItem('theme', DARK_MODE);
			document.documentElement.classList.add('dark');

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<script is:inline>
			(() => {
				const dismissedKey = "__serveltIntroDismissed";
				const internalNavigationKey = "__serveltInternalNavigation";
				const internalNavigationWindow = 8000;
				const navigation = performance.getEntriesByType?.("navigation")?.[0];
				const navigationType = navigation?.type || "navigate";
				let shouldSkip = navigationType === "back_forward";

				try {
					const marker = Number(sessionStorage.getItem(internalNavigationKey));
					if (navigationType === "reload") {
						sessionStorage.removeItem(internalNavigationKey);
					} else if (Number.isFinite(marker) && Date.now() - marker < internalNavigationWindow) {
						shouldSkip = true;
						sessionStorage.removeItem(internalNavigationKey);
					}
				} catch {}

				if (shouldSkip) {
					window[dismissedKey] = true;
					document.documentElement.classList.add("site-intro-skip");
				}
			})();
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<ConfigCarrier></ConfigCarrier>
		<div id="site-entry-intro" class="site-entry-intro" aria-hidden="false">
			<span id="site-entry-wash" class="site-entry-wash" aria-hidden="true"></span>
			<button id="site-entry-trigger" class="site-entry-trigger" type="button" aria-label={`Enter ${siteConfig.title}`}>
				<span class="site-entry-card">
					<span class="site-entry-aura" aria-hidden="true"></span>
					<span class="site-entry-flipper">
						<span class="site-entry-avatar">
							<ImageWrapper src={profileConfig.avatar || ""} alt="Profile Image of the Author" class="site-entry-avatar-image"></ImageWrapper>
						</span>
						<span class="site-entry-back" aria-hidden="true"></span>
					</span>
				</span>
			</button>
		</div>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}

.site-intro-active,
.site-intro-active body {
	overflow: hidden;
}

.site-intro-skip .site-entry-intro {
	display: none !important;
}

.site-entry-hidden-target {
	opacity: 0;
	transform: translate3d(0, 1.35rem, 0) scale(0.965);
	transform-origin: center top;
	filter: blur(12px);
	animation: none !important;
	transition: none !important;
	will-change: opacity, transform, filter;
}

.site-intro-blank .home-shell::before,
.site-intro-blank .archive-shell::before {
	opacity: 0 !important;
}

.site-entry-intro {
	position: fixed;
	inset: 0;
	z-index: 9999;
	display: grid;
	place-items: center;
	overflow: hidden;
	background:
		radial-gradient(circle at 50% 42%, rgba(213, 166, 255, 0.22), transparent 17rem),
		radial-gradient(circle at 18% 16%, rgba(174, 88, 255, 0.16), transparent 22rem),
		radial-gradient(circle at 84% 78%, rgba(198, 132, 255, 0.12), transparent 24rem),
		rgb(8 5 14 / 0.96);
	backdrop-filter: blur(18px);
	cursor: pointer;
}

.site-entry-intro::before {
	content: "";
	position: absolute;
	inset: -20%;
	background:
		radial-gradient(circle, rgba(246, 228, 255, 0.72) 0 1px, transparent 1.8px) 12% 18% / 9rem 9rem,
		radial-gradient(circle, rgba(202, 142, 255, 0.38) 0 1px, transparent 1.7px) 74% 28% / 12rem 12rem,
		radial-gradient(circle, rgba(232, 202, 255, 0.3) 0 1px, transparent 1.6px) 42% 72% / 10rem 10rem;
	opacity: 0.42;
	animation: site-intro-stars 9s linear infinite;
}

.site-entry-intro::after {
	content: "";
	position: absolute;
	inset: -12%;
	background:
		repeating-linear-gradient(
			100deg,
			transparent 0 1.2rem,
			rgba(235, 210, 255, 0.12) 1.2rem 1.28rem,
			transparent 1.28rem 2.4rem
		);
	mask-image: linear-gradient(90deg, transparent, black 28%, black 72%, transparent);
	opacity: 0;
	transform: translateX(-18%);
	pointer-events: none;
}

.site-entry-intro.is-running {
	pointer-events: none;
	cursor: default;
}

.site-entry-intro.is-running .site-entry-aura {
	animation: none;
}

.site-entry-wash {
	position: absolute;
	inset: -28vmax;
	z-index: 1;
	display: block;
	border-radius: 50%;
	background:
		radial-gradient(circle at 50% 50%,
			rgba(255, 248, 255, 0.58) 0 4%,
			rgba(230, 188, 255, 0.44) 16%,
			rgba(171, 82, 255, 0.34) 36%,
			rgba(84, 28, 150, 0.2) 56%,
			transparent 78%);
	filter: blur(28px) brightness(1.1) saturate(1.16);
	mix-blend-mode: screen;
	opacity: 0;
	pointer-events: none;
	transform: scale(0.02);
	transform-origin: center;
	will-change: opacity, transform, filter;
}

.site-entry-trigger {
	all: unset;
	position: relative;
	z-index: 3;
	display: grid;
	place-items: center;
	width: clamp(15rem, 26vw, 19rem);
	aspect-ratio: 1;
	border-radius: 1.35rem;
	cursor: pointer;
	perspective: 1800px;
	transform-style: preserve-3d;
	animation: site-intro-pop 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	transition: filter 0.18s ease;
	will-change: opacity, filter;
}

.site-entry-trigger.is-tilt-ready,
.site-entry-card.is-tilt-ready {
	animation: none;
}

.site-entry-card {
	--entry-rotate-x: 0deg;
	--entry-rotate-y: 0deg;
	--entry-pointer-x: 0px;
	--entry-pointer-y: 0px;
	--entry-image-x: 0px;
	--entry-image-y: 0px;
	--entry-inner-rotate-x: 0deg;
	--entry-inner-rotate-y: 0deg;
	--entry-lift-y: 0px;
	--entry-translate-z: 0px;
	--entry-scale: 1;
	--entry-glow-x: 50%;
	--entry-glow-y: 48%;
	position: relative;
	isolation: isolate;
	display: grid;
	place-items: center;
	width: 100%;
	height: 100%;
	border-radius: inherit;
	transform:
		translate3d(var(--entry-pointer-x), calc(var(--entry-pointer-y) + var(--entry-lift-y)), 0)
		rotateX(var(--entry-rotate-x))
		rotateY(var(--entry-rotate-y))
		translateZ(var(--entry-translate-z))
		scale(var(--entry-scale));
	transform-style: preserve-3d;
	perspective-origin: 50% 48%;
	transition: transform 0.14s cubic-bezier(0.18, 0.78, 0.18, 1), filter 0.2s ease;
	will-change: transform, filter;
}

.site-entry-card.is-flipping::before,
.site-entry-card.is-flipping::after {
	opacity: 0;
	transition: opacity 0.22s ease;
}

.site-entry-card.is-flipping {
	--entry-rotate-x: 0deg;
	--entry-rotate-y: 0deg;
	--entry-pointer-x: 0px;
	--entry-pointer-y: 0px;
	--entry-lift-y: 0px;
	--entry-translate-z: 0px;
	--entry-scale: 1;
	filter: none;
	transition: none;
}

.site-entry-card.is-flipping .site-entry-flipper {
	animation: none;
}

.site-entry-aura,
.site-entry-card::before,
.site-entry-card::after {
	content: "";
	position: absolute;
	inset: -0.8rem;
	border-radius: inherit;
	pointer-events: none;
}

.site-entry-aura {
	inset: -1.2rem;
	border-radius: 2.25rem;
	background:
		radial-gradient(circle at 50% 42%, rgba(252, 241, 255, 0.32), transparent 42%),
		radial-gradient(circle at 72% 18%, rgba(198, 116, 255, 0.36), transparent 42%),
		conic-gradient(from 216deg, transparent, rgba(237, 214, 255, 0.48), transparent 34%, rgba(174, 88, 255, 0.36), transparent 70%);
	filter: blur(18px);
	opacity: 0.68;
	animation: site-intro-orbit 7s linear infinite;
	transition: inset 0.22s ease, opacity 0.22s ease, filter 0.22s ease;
}

.site-entry-flipper {
	position: absolute;
	inset: 0;
	z-index: 2;
	display: block;
	border-radius: inherit;
	transform:
		translateZ(1.2rem)
		rotateX(var(--entry-inner-rotate-x))
		rotateY(var(--entry-inner-rotate-y));
	transform-style: preserve-3d;
	transform-origin: center;
	-webkit-transform-style: preserve-3d;
	transition: transform 0.14s cubic-bezier(0.18, 0.78, 0.18, 1);
	will-change: transform;
}

.site-entry-card::before {
	inset: -0.12rem;
	border: 1px solid rgba(238, 216, 255, 0.42);
	border-radius: inherit;
	box-shadow:
		0 1.5rem 4.6rem rgba(14, 4, 26, 0.6),
		0 0 2.2rem rgba(214, 168, 255, 0.3),
		0 0 5.4rem rgba(172, 92, 255, 0.18);
	backface-visibility: hidden;
	-webkit-backface-visibility: hidden;
	transition: border-color 0.22s ease, box-shadow 0.22s ease;
}

.site-entry-card::after {
	inset: 0.35rem -0.6rem -1.05rem;
	border-radius: 50%;
	background: radial-gradient(ellipse at 50% 55%, rgba(158, 78, 255, 0.28), transparent 66%);
	filter: blur(18px);
	opacity: 0.76;
	transform: translateZ(-3.6rem) rotateX(72deg);
	backface-visibility: hidden;
	-webkit-backface-visibility: hidden;
}

.site-entry-avatar {
	position: absolute;
	inset: 0;
	z-index: 2;
	display: block;
	overflow: hidden;
	padding: 0.42rem;
	border-radius: inherit;
	background:
		linear-gradient(135deg, rgba(255, 248, 255, 0.92), rgba(202, 137, 255, 0.56) 34%, rgba(92, 38, 153, 0.78)),
		linear-gradient(160deg, rgba(32, 15, 52, 0.96), rgba(8, 4, 16, 0.98));
	box-shadow:
		0 0 0 1px rgba(244, 229, 255, 0.28),
		0 1.35rem 4.8rem rgba(16, 5, 31, 0.76),
		0 0 3.6rem rgba(194, 114, 255, 0.48),
		inset 0 1px 0 rgba(255, 255, 255, 0.28),
		inset 0 -1.2rem 2.4rem rgba(86, 33, 150, 0.18);
	backface-visibility: hidden;
	-webkit-backface-visibility: hidden;
	transform: rotateY(0deg) translateZ(1.2px);
	transform-style: preserve-3d;
	transform-origin: center;
	-webkit-transform-style: preserve-3d;
}

.site-entry-back {
	position: absolute;
	inset: 0;
	z-index: 2;
	display: block;
	overflow: hidden;
	border: 1px solid rgba(250, 239, 255, 0.5);
	border-radius: inherit;
	background:
		radial-gradient(circle at 50% 46%, rgba(255, 249, 255, 0.74) 0 7%, rgba(232, 197, 255, 0.32) 20%, transparent 45%),
		linear-gradient(132deg, rgba(255, 255, 255, 0.12), transparent 26%, rgba(255, 255, 255, 0.06) 58%, transparent 76%),
		linear-gradient(145deg, rgba(27, 10, 49, 0.98), rgba(101, 36, 166, 0.92) 48%, rgba(15, 6, 29, 0.99));
	box-shadow:
		0 1.5rem 5.2rem rgba(15, 4, 30, 0.66),
		0 0 3.2rem rgba(209, 152, 255, 0.48),
		0 0 6.8rem rgba(176, 82, 255, 0.28),
		inset 0 1px 0 rgba(255, 255, 255, 0.24),
		inset 0 0 4.6rem rgba(214, 168, 255, 0.22);
	opacity: 1;
	visibility: visible;
	pointer-events: none;
	backface-visibility: hidden;
	-webkit-backface-visibility: hidden;
	transform: rotateY(180deg) translateZ(1.2px);
	transform-style: preserve-3d;
	transform-origin: center;
	-webkit-transform-style: preserve-3d;
	will-change: transform, opacity;
}

.site-entry-back::before {
	content: "";
	position: absolute;
	inset: -8%;
	border-radius: inherit;
	background:
		linear-gradient(118deg, transparent 20%, rgba(255, 255, 255, 0.18) 42%, transparent 60%),
		repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 0.78rem);
	opacity: 0.52;
	mix-blend-mode: screen;
	transform: translateZ(0.46rem) translateX(-8%);
}

.site-entry-back::after {
	content: "";
	position: absolute;
	inset: -4%;
	border-radius: inherit;
	background:
		radial-gradient(circle at 50% 44%, rgba(255, 255, 255, 0.92), rgba(239, 214, 255, 0.5) 24%, rgba(188, 92, 255, 0.2) 54%, transparent 74%);
	box-shadow:
		0 0 2.4rem rgba(238, 212, 255, 0.68),
		0 0 6.2rem rgba(178, 80, 255, 0.5),
		inset 0 0 2rem rgba(255, 255, 255, 0.2);
	opacity: 0.34;
	transform: translateZ(0.82rem) scale(0.58);
}

.site-entry-card.is-flipping .site-entry-back::after {
	animation: site-entry-back-core 0.98s cubic-bezier(0.16, 0.84, 0.18, 1) 0.48s both;
}

.site-entry-card.is-flipping .site-entry-back::before {
	animation: site-entry-back-sheen 1.02s cubic-bezier(0.16, 0.84, 0.18, 1) 0.5s both;
}

.site-entry-avatar::after {
	content: "";
	position: absolute;
	inset: 0.42rem;
	z-index: 2;
	border-radius: 0.98rem;
	background:
		radial-gradient(circle at var(--entry-glow-x) var(--entry-glow-y), rgba(255, 255, 255, 0.56), rgba(232, 202, 255, 0.22) 18%, transparent 44%),
		linear-gradient(135deg, rgba(255, 255, 255, 0.18), transparent 36%, rgba(174, 88, 255, 0.16) 72%, transparent);
	mix-blend-mode: screen;
	opacity: 0.42;
	pointer-events: none;
	transform: translateZ(2.2rem);
	transition: opacity 0.16s ease;
}

.site-entry-avatar-image {
	position: relative;
	z-index: 1;
	width: 100%;
	height: 100%;
	border-radius: 0.98rem;
	box-shadow: inset 0 0 2.2rem rgba(8, 5, 14, 0.28);
	transform:
		translate3d(var(--entry-image-x), var(--entry-image-y), 1.8rem)
		scale(1.02);
	transform-style: preserve-3d;
	backface-visibility: hidden;
	-webkit-backface-visibility: hidden;
	transition: transform 0.18s cubic-bezier(0.18, 0.78, 0.18, 1), filter 0.18s ease;
	will-change: transform;
}

.site-entry-card.is-flipping .site-entry-avatar {
	pointer-events: none;
}

.site-entry-card.is-flipping .site-entry-back {
	filter: brightness(1.04) saturate(1.1);
}

.site-entry-card.is-back-lit .site-entry-avatar,
.site-entry-card.is-back-lit .site-entry-avatar * {
	pointer-events: none !important;
}

.site-entry-card.is-back-lit .site-entry-back {
	filter: brightness(1.18) saturate(1.16);
}

.site-entry-trigger:hover {
	filter: brightness(1.08);
}

.site-entry-trigger:hover .site-entry-card {
	--entry-lift-y: -0.34rem;
	--entry-translate-z: 2.8rem;
	--entry-scale: 1.055;
}

.site-entry-trigger:hover .site-entry-card:not(.is-pointer-active):not(.is-flipping) {
	--entry-rotate-x: -7deg;
	--entry-rotate-y: 11deg;
	--entry-inner-rotate-x: -3deg;
	--entry-inner-rotate-y: 5deg;
}

.site-entry-card.is-pointer-active {
	filter:
		drop-shadow(0 1.25rem 2.8rem rgba(15, 5, 28, 0.46))
		drop-shadow(0 0 2.6rem rgba(198, 132, 255, 0.2));
}

.site-entry-trigger:hover .site-entry-aura {
	inset: -2.1rem;
	opacity: 1;
	filter: blur(22px) brightness(1.42);
}

.site-entry-trigger:hover .site-entry-card::before {
	border-color: rgba(248, 232, 255, 0.58);
	box-shadow:
		0 1.7rem 5rem rgba(14, 4, 26, 0.62),
		0 0 3.2rem rgba(232, 202, 255, 0.48),
		0 0 7.4rem rgba(178, 80, 255, 0.34);
}

.site-entry-trigger:hover .site-entry-avatar {
	box-shadow:
		0 0 0 1px rgba(248, 232, 255, 0.34),
		0 1.2rem 4.6rem rgba(29, 10, 48, 0.78),
		0 0 4.4rem rgba(214, 168, 255, 0.66),
		inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.site-entry-trigger:hover .site-entry-avatar::after {
	opacity: 0.66;
}

.site-entry-intro.is-charging {
	animation: site-intro-charge-bg 0.58s cubic-bezier(0.2, 0.72, 0.2, 1) forwards;
}

.site-entry-intro.is-charging::before {
	animation:
		site-intro-stars 1.3s linear infinite,
		site-intro-stars-charge 0.58s ease-out forwards;
}

.site-entry-intro.is-charging::after {
	animation: site-intro-streak 0.58s ease-out forwards;
}

.site-entry-intro.is-charging .site-entry-aura {
	animation:
		site-intro-orbit 0.72s linear infinite,
		site-intro-aura-charge 0.58s ease-out forwards;
}

.site-entry-intro.is-charging .site-entry-trigger {
