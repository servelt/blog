<script is:inline>
(() => {
	const dismissedKey = "__serveltIntroDismissed";
	const internalNavigationKey = "__serveltInternalNavigation";
	const revealStepDelay = 34;
	const revealDuration = 560;
	const maxRevealTargets = 48;
	const internalNavigationWindow = 8000;

	function collectElements(selectors) {
		return selectors.flatMap((selector) =>
			Array.from(document.querySelectorAll(selector)),
		);
	}

	function buildRevealTargets() {
		if (document.querySelector(".about-page")) {
			return [];
		}

			const baseSelectors = [
				"#banner-wrapper",
				"#navbar-wrapper",
				"#sidebar",
				"#swup-container > :not(main)",
		];
		const contentSelectors = [
			".home-feature",
			".home-section-head",
			".home-post-row",
			".archive-summary",
			".archive-item",
			"#post-container > *",
		];

		const seen = new Set();
		const targets = [];

		const pushElement = (element) => {
			if (!(element instanceof HTMLElement)) return;
			if (element.closest("#site-entry-intro")) return;
			if (seen.has(element)) return;
			seen.add(element);
			targets.push(element);
		};

		collectElements(baseSelectors).forEach(pushElement);

		const contentTargets = [];
		collectElements(contentSelectors).forEach((element) => {
			if (!(element instanceof HTMLElement)) return;
			if (seen.has(element)) return;
			contentTargets.push(element);
		});

		if (contentTargets.length > 0) {
			contentTargets.forEach(pushElement);
		} else {
			collectElements(["#content-wrapper > *"]).forEach(pushElement);
		}

		return targets.slice(0, maxRevealTargets).map((element) => {
			element.classList.add("site-entry-hidden-target");
			element.style.opacity = "0";
			element.style.transform = "translate3d(0, 1.35rem, 0) scale(0.965)";
			element.style.filter = "blur(12px)";
			return element;
		});
	}

	function clearRevealTargets(targets) {
		targets.forEach((element) => {
			element.classList.remove("site-entry-hidden-target");
			element.style.removeProperty("opacity");
			element.style.removeProperty("transform");
			element.style.removeProperty("filter");
		});
	}

	function animateElement(element, keyframes, options) {
		if (!element || typeof element.animate !== "function") return null;
		return element.animate(keyframes, options);
	}

	function clampNumber(value, min, max) {
		return Math.min(max, Math.max(min, value));
	}

	function initEntryTilt(overlay, trigger) {
		if (!overlay || !trigger) return () => {};
		const card = trigger.querySelector(".site-entry-card");
		const flipper = trigger.querySelector(".site-entry-flipper");
		const image = trigger.querySelector(".site-entry-avatar-image");
		if (!(card instanceof HTMLElement)) return () => {};
		if (!(flipper instanceof HTMLElement)) return () => {};
		if (card.dataset.tiltBound === "true") return () => {};
		card.dataset.tiltBound = "true";

		const readyTimer = window.setTimeout(() => {
			card.classList.add("is-tilt-ready");
		}, 720);

		const isInsideTrigger = (event, rect = trigger.getBoundingClientRect()) =>
			event.clientX >= rect.left &&
			event.clientX <= rect.right &&
			event.clientY >= rect.top &&
			event.clientY <= rect.bottom;

		const resetTilt = () => {
			card.classList.remove("is-pointer-active");
			card.style.setProperty("--entry-rotate-x", "0deg");
			card.style.setProperty("--entry-rotate-y", "0deg");
			card.style.setProperty("--entry-pointer-x", "0px");
			card.style.setProperty("--entry-pointer-y", "0px");
			card.style.setProperty("--entry-image-x", "0px");
			card.style.setProperty("--entry-image-y", "0px");
			card.style.setProperty("--entry-inner-rotate-x", "0deg");
			card.style.setProperty("--entry-inner-rotate-y", "0deg");
			card.style.setProperty("--entry-glow-x", "50%");
			card.style.setProperty("--entry-glow-y", "48%");
			card.style.removeProperty("transform");
			flipper.style.removeProperty("transform");
			if (image instanceof HTMLElement) image.style.removeProperty("transform");
		};

		const onPointerMove = (event) => {
			if (overlay.classList.contains("is-running")) return;
			if (event.pointerType === "touch") return;

			const rect = trigger.getBoundingClientRect();
			if (!isInsideTrigger(event, rect)) {
				resetTilt();
				return;
			}

			const centerX = rect.left + rect.width / 2;
			const centerY = rect.top + rect.height / 2;
			const ratioX = clampNumber((event.clientX - centerX) / (rect.width * 0.62), -1, 1);
			const ratioY = clampNumber((event.clientY - centerY) / (rect.height * 0.62), -1, 1);
			const glowX = clampNumber(((event.clientX - rect.left) / rect.width) * 100, 6, 94);
			const glowY = clampNumber(((event.clientY - rect.top) / rect.height) * 100, 6, 94);

			const rotateX = -ratioY * 34;
			const rotateY = ratioX * 46;
			const moveX = ratioX * 11;
			const moveY = ratioY * 9;
			const imageX = ratioX * 24;
			const imageY = ratioY * 18;
			const innerRotateX = -ratioY * 10;
			const innerRotateY = ratioX * 14;

			card.classList.add("is-pointer-active");
			card.style.setProperty("--entry-glow-x", `${glowX.toFixed(1)}%`);
			card.style.setProperty("--entry-glow-y", `${glowY.toFixed(1)}%`);
			card.style.setProperty("--entry-rotate-x", `${rotateX.toFixed(2)}deg`);
			card.style.setProperty("--entry-rotate-y", `${rotateY.toFixed(2)}deg`);
			card.style.setProperty("--entry-pointer-x", `${moveX.toFixed(2)}px`);
			card.style.setProperty("--entry-pointer-y", `${moveY.toFixed(2)}px`);
			card.style.setProperty("--entry-image-x", `${imageX.toFixed(2)}px`);
			card.style.setProperty("--entry-image-y", `${imageY.toFixed(2)}px`);
			card.style.setProperty("--entry-inner-rotate-x", `${innerRotateX.toFixed(2)}deg`);
			card.style.setProperty("--entry-inner-rotate-y", `${innerRotateY.toFixed(2)}deg`);

			card.style.transform = [
				`translate3d(${moveX.toFixed(2)}px, ${(moveY - 7).toFixed(2)}px, 0)`,
				`rotateX(${rotateX.toFixed(2)}deg)`,
				`rotateY(${rotateY.toFixed(2)}deg)`,
				"translateZ(48px)",
				"scale(1.075)",
			].join(" ");
			flipper.style.transform = [
				"translateZ(26px)",
				`rotateX(${innerRotateX.toFixed(2)}deg)`,
				`rotateY(${innerRotateY.toFixed(2)}deg)`,
			].join(" ");
			if (image instanceof HTMLElement) {
				image.style.transform = `translate3d(${imageX.toFixed(2)}px, ${imageY.toFixed(2)}px, 32px) scale(1.055)`;
			}
		};

		trigger.addEventListener("pointermove", onPointerMove, { passive: true });
		trigger.addEventListener("mousemove", onPointerMove, { passive: true });
		card.addEventListener("pointermove", onPointerMove, { passive: true });
		card.addEventListener("mousemove", onPointerMove, { passive: true });
		overlay.addEventListener("pointermove", onPointerMove, { passive: true });
		overlay.addEventListener("mousemove", onPointerMove, { passive: true });
		document.addEventListener("pointermove", onPointerMove, { passive: true, capture: true });
		document.addEventListener("mousemove", onPointerMove, { passive: true, capture: true });
		window.addEventListener("pointermove", onPointerMove, { passive: true });
		window.addEventListener("mousemove", onPointerMove, { passive: true });
		trigger.addEventListener("pointercancel", resetTilt);

		return () => {
			window.clearTimeout(readyTimer);
			trigger.removeEventListener("pointermove", onPointerMove);
			trigger.removeEventListener("mousemove", onPointerMove);
			card.removeEventListener("pointermove", onPointerMove);
			card.removeEventListener("mousemove", onPointerMove);
			overlay.removeEventListener("pointermove", onPointerMove);
			overlay.removeEventListener("mousemove", onPointerMove);
			document.removeEventListener("pointermove", onPointerMove, { capture: true });
			document.removeEventListener("mousemove", onPointerMove, { capture: true });
			window.removeEventListener("pointermove", onPointerMove);
			window.removeEventListener("mousemove", onPointerMove);
			trigger.removeEventListener("pointercancel", resetTilt);
			card.classList.remove("is-tilt-ready");
			card.classList.remove("is-pointer-active");
			delete card.dataset.tiltBound;
			card.style.removeProperty("transform");
			flipper.style.removeProperty("transform");
			if (image instanceof HTMLElement) image.style.removeProperty("transform");
			[
				"--entry-rotate-x",
				"--entry-rotate-y",
				"--entry-pointer-x",
				"--entry-pointer-y",
				"--entry-image-x",
				"--entry-image-y",
				"--entry-inner-rotate-x",
				"--entry-inner-rotate-y",
				"--entry-glow-x",
				"--entry-glow-y",
			].forEach((property) => card.style.removeProperty(property));
		};
	}

	function markInternalNavigation(event) {
		const link = event.target?.closest?.("a[href]");
		if (!link || link.target || link.hasAttribute("download")) return;

		const targetUrl = new URL(link.href, window.location.href);
		if (targetUrl.origin !== window.location.origin) return;
		if (targetUrl.pathname === window.location.pathname && targetUrl.hash) return;

		try {
			sessionStorage.setItem(internalNavigationKey, String(Date.now()));
			window.setTimeout(() => {
				const marker = Number(sessionStorage.getItem(internalNavigationKey));
				if (Number.isFinite(marker) && Date.now() - marker >= internalNavigationWindow) {
					sessionStorage.removeItem(internalNavigationKey);
				}
			}, internalNavigationWindow + 200);
		} catch {}
	}

	function shouldSkipIntro() {
		if (window[dismissedKey]) return true;

		const navigation = performance.getEntriesByType?.("navigation")?.[0];
		const navigationType = navigation?.type || "navigate";

		if (navigationType === "reload") {
			try {
				sessionStorage.removeItem(internalNavigationKey);
			} catch {}
			return false;
		}

		try {
			const marker = Number(sessionStorage.getItem(internalNavigationKey));
			sessionStorage.removeItem(internalNavigationKey);
			if (Number.isFinite(marker) && Date.now() - marker < internalNavigationWindow) {
				window[dismissedKey] = true;
				return true;
			}
		} catch {}

		if (navigationType === "back_forward") {
			window[dismissedKey] = true;
			return true;
		}

		return false;
	}

	function playContentReveal(targets) {
		const animations = targets.map((element, index) => {
			const animation = animateElement(
				element,
				[
					{
						opacity: 0,
						transform: "translate3d(0, 1.35rem, 0) scale(0.965)",
						filter: "blur(12px)",
					},
					{
						opacity: 1,
						transform: "translate3d(0, -0.16rem, 0) scale(1.01)",
						filter: "blur(1px)",
						offset: 0.58,
					},
					{
						opacity: 1,
						transform: "translate3d(0, 0, 0) scale(1)",
						filter: "blur(0)",
					},
				],
				{
					delay: index * revealStepDelay,
					duration: revealDuration,
					easing: "cubic-bezier(0.15, 0.88, 0.18, 1)",
					fill: "both",
				},
			);

			if (!animation) {
				element.style.opacity = "1";
				element.style.transform = "translate3d(0, 0, 0) scale(1)";
				element.style.filter = "blur(0)";
			}

			return animation;
		});

		window.setTimeout(() => {
			animations.forEach((animation) => animation?.cancel());
			clearRevealTargets(targets);
			document.documentElement.classList.remove("site-intro-blank");
		}, targets.length * revealStepDelay + revealDuration + 180);
	}

	function initSiteIntro() {
		const overlay = document.getElementById("site-entry-intro");
		if (!overlay) return;

		if (shouldSkipIntro()) {
			overlay.remove();
			document.documentElement.classList.remove("site-intro-active");
			return;
		}

		document.documentElement.classList.add("site-intro-active");
		const entryTrigger = document.getElementById("site-entry-trigger");
		const cleanupEntryTilt =
			entryTrigger instanceof HTMLElement ? initEntryTilt(overlay, entryTrigger) : () => {};

		const closeIntro = () => {
			if (overlay.classList.contains("is-running")) return;

			const revealTargets = buildRevealTargets();
			const trigger = entryTrigger;
			const entryCard = trigger?.querySelector?.(".site-entry-card");
			const flipper = entryCard?.querySelector?.(".site-entry-flipper");
			const aura = overlay.querySelector(".site-entry-aura");
			const wash = document.getElementById("site-entry-wash");
			const flipDuration = 1180;
			const bloomStart = 540;
			const exitStart = 1240;
			const overlayFadeStart = 1780;
			const removeAt = 2660;

			window[dismissedKey] = true;
			document.documentElement.classList.add("site-intro-blank");
			overlay.classList.add("is-running");
			overlay.dispatchEvent(new CustomEvent("intro:start"));
			overlay.setAttribute("aria-hidden", "true");
			document.removeEventListener("keydown", onKeydown);
			cleanupEntryTilt();

			if (entryCard instanceof HTMLElement) {
				entryCard.classList.add("is-flipping");
				entryCard.classList.remove("is-pointer-active");
				entryCard.style.setProperty("--entry-rotate-x", "0deg");
				entryCard.style.setProperty("--entry-rotate-y", "0deg");
				entryCard.style.setProperty("--entry-pointer-x", "0px");
				entryCard.style.setProperty("--entry-pointer-y", "0px");
				entryCard.style.setProperty("--entry-image-x", "0px");
				entryCard.style.setProperty("--entry-image-y", "0px");
				entryCard.style.setProperty("--entry-lift-y", "0px");
				entryCard.style.setProperty("--entry-translate-z", "0px");
				entryCard.style.setProperty("--entry-scale", "1");
			}

			animateElement(
				flipper,
				[
					{ transform: "translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1)" },
					{
						transform: "translate3d(0, -0.1rem, 4.2rem) rotateX(-2.4deg) rotateY(46deg) scale(1.015)",
						offset: 0.28,
					},
					{
						transform: "translate3d(0, -0.13rem, 5.8rem) rotateX(-1deg) rotateY(90deg) scale(1.024)",
						offset: 0.5,
					},
					{
						transform: "translate3d(0, -0.08rem, 4rem) rotateX(1.2deg) rotateY(136deg) scale(1.014)",
						offset: 0.72,
					},
					{ transform: "translate3d(0, 0, 0.9rem) rotateX(0deg) rotateY(180deg) scale(1)" },
				],
				{
					duration: flipDuration,
					easing: "cubic-bezier(0.26, 0.72, 0.18, 1)",
					fill: "forwards",
				},
			);
			window.setTimeout(() => {
				if (entryCard instanceof HTMLElement) entryCard.classList.add("is-back-lit");
			}, bloomStart);

			animateElement(
				trigger,
				[
					{
						opacity: 1,
						transform: "translate3d(0, 0, 0) scale(1)",
					},
					{
						opacity: 0.95,
						transform: "translate3d(0, -0.08rem, 0) scale(1.03)",
						offset: 0.28,
					},
					{
						opacity: 0.38,
						transform: "translate3d(0, -0.28rem, 0) scale(0.98)",
						offset: 0.76,
					},
					{
						opacity: 0,
						transform: "translate3d(0, -0.42rem, 0) scale(0.92)",
					},
				],
				{
					delay: exitStart,
					duration: 860,
					easing: "cubic-bezier(0.18, 0.78, 0.18, 1)",
					fill: "forwards",
				},
			);

			animateElement(
				wash,
				[
					{ opacity: 0, transform: "scale(0.03)" },
					{ opacity: 0.68, transform: "scale(0.46)", offset: 0.34 },
					{ opacity: 0.34, transform: "scale(1.18)", offset: 0.72 },
					{ opacity: 0, transform: "scale(1.68)" },
				],
				{
					delay: exitStart - 80,
					duration: 1220,
					easing: "cubic-bezier(0.18, 0.82, 0.18, 1)",
					fill: "forwards",
				},
			);

			animateElement(
				aura,
				[
					{ opacity: 0.78, transform: "scale(1) rotate(0deg)" },
					{ opacity: 0.92, transform: "scale(1.16) rotate(18deg)", offset: 0.34 },
					{ opacity: 0.42, transform: "scale(1.72) rotate(82deg)", offset: 0.72 },
					{ opacity: 0, transform: "scale(2.34) rotate(132deg)" },
				],
				{
					delay: bloomStart,
					duration: 1700,
					easing: "cubic-bezier(0.16, 0.84, 0.18, 1)",
					fill: "forwards",
				},
			);

			animateElement(
				overlay,
				[
					{ opacity: 1 },
					{ opacity: 0.96, offset: 0.3 },
					{ opacity: 0.42, offset: 0.72 },
					{ opacity: 0 },
				],
				{
					delay: overlayFadeStart,
					duration: 720,
					easing: "cubic-bezier(0.22, 0.72, 0.2, 1)",
					fill: "forwards",
				},
			);

			window.setTimeout(() => {
				document.documentElement.classList.remove("site-intro-active");
				overlay.remove();
				playContentReveal(revealTargets);
			}, removeAt);
		};

		const onKeydown = (event) => {
			if (event.key === "Enter" || event.key === " " || event.key === "Escape") {
				event.preventDefault();
				closeIntro();
				document.removeEventListener("keydown", onKeydown);
			}
		};

		overlay.addEventListener("click", closeIntro, { once: true });
		document.addEventListener("keydown", onKeydown);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initSiteIntro, { once: true });
	} else {
		initSiteIntro();
	}

	document.addEventListener("click", markInternalNavigation, true);
})();
</script>

