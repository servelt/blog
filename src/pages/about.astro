---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)} hideSidebar={true} flowContent={true}>
	<div class="about-page">
		<div class="about-story">
			<div class="about-stage">
				<section class="about-hero" aria-labelledby="about-name">
					<div class="about-avatar">
						<ImageWrapper src={profileConfig.avatar || ""} alt="Profile Image of the Author" class="h-full w-full"></ImageWrapper>
					</div>
					<div class="about-copy">
						<p class="about-kicker">Security / CTF / Development</p>
						<h1 id="about-name">{profileConfig.name}</h1>
						<p class="about-bio">{profileConfig.bio}</p>
						<div class="about-actions">
							{profileConfig.links.map((item) => (
								<a href={item.url} target="_blank" rel="noopener noreferrer" class="btn-regular about-link">
									{item.icon && <Icon name={item.icon} class="text-[1.25rem]"></Icon>}
									<span>{item.name}</span>
									<Icon name="material-symbols:arrow-outward-rounded" class="about-link-arrow" />
								</a>
							))}
						</div>
					</div>
					<a class="about-scroll-cue" href="#about-details">
						<span>Explore my journey</span>
						<Icon name="material-symbols:arrow-downward-rounded" class="text-[1.1rem]" />
					</a>
				</section>
				<section class="about-overview" aria-labelledby="about-intro-heading">
					<div class="about-overview-inner">
						<p class="about-kicker">A little about me</p>
						<h2 id="about-intro-heading">About Me</h2>
						<p class="about-introduction">보안, 개발을 공부하고 있는 고등학생 Servelt라고 합니다!</p>
						<div class="about-stats" role="group" aria-label="Blog stats">
							{aboutStats.map((item) => (
								<div class="about-stat-card">
									<Icon name={item.icon} class="about-stat-icon" />
									<div class="about-stat-value">{item.value}</div>
									<div class="about-stat-label">{item.label}</div>
								</div>
							))}
						</div>
					</div>
				</section>
			</div>
		</div>
		<div id="about-details" class="about-content about-timeline">
			{timelineSections.map((section, index) => (
				<section class="about-timeline-section" aria-labelledby={"about-section-" + index}>
					<header class="about-section-heading">
						<span class="about-section-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
						<h2 id={"about-section-" + index}>{section.title}</h2>
					</header>
					<Timeline entries={section.entries}></Timeline>
				</section>
			))}
		</div>
	</div>
</MainGridLayout>

<style is:global>
	html:has(.about-page) #top-row {
		position: fixed;
		inset: 0 0 auto;
		z-index: 80;
	}

	html:has(.about-page) #navbar {
		background: linear-gradient(110deg, rgb(40 23 59 / 0.97), rgb(13 9 20 / 0.98));
		backdrop-filter: blur(16px);
	}

	.about-page {
		--about-nav-height: 5.5rem;
		position: relative;
		isolation: isolate;
		width: 100vw;
		margin-top: calc(-1 * var(--about-nav-height));
		margin-left: calc(50% - 50vw);
		padding-top: var(--about-nav-height);
		overflow-x: clip;
		color: rgb(248 239 255);
		background:
			radial-gradient(ellipse at 15% 12rem, rgb(162 82 239 / 0.16), transparent 34rem),
			radial-gradient(ellipse at 88% 32rem, rgb(140 64 224 / 0.12), transparent 32rem),
			linear-gradient(180deg, #090610, #0c0715 48%, #07050c);
	}

	.about-stage {
		padding-inline: clamp(1.5rem, 5vw, 5rem);
	}

	.about-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		gap: clamp(3.5rem, 8vw, 8rem);
		width: min(100%, 70rem);
		min-height: calc(100svh - var(--about-nav-height));
		margin-inline: auto;
		padding-block: 4rem 7rem;
	}

	.about-avatar {
		position: relative;
		width: min(100%, 25rem);
		aspect-ratio: 1;
		justify-self: center;
		padding: 0.4rem;
		border: 1px solid rgb(232 206 255 / 0.36);
		border-radius: 1.5rem;
		background: linear-gradient(145deg, rgb(237 215 255 / 0.3), rgb(160 76 238 / 0.08) 55%, rgb(212 163 255 / 0.25));
		box-shadow:
			0 0 0 0.65rem rgb(193 134 242 / 0.035),
			0 2rem 6rem -2.5rem rgb(172 92 246 / 0.4);
	}

	.about-avatar > div {
		border-radius: 1.1rem;
	}

	.about-copy {
		min-width: 0;
	}

	.about-kicker {
		margin: 0;
		color: rgb(208 168 244);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.8;
		text-transform: uppercase;
	}

	.about-copy h1 {
		margin: 1.2rem 0 1.4rem;
		color: transparent;
		background: linear-gradient(160deg, #fff 15%, #efdbff 55%, #c799f0);
		background-clip: text;
		-webkit-background-clip: text;
		font-size: clamp(4rem, 7.8vw, 7rem);
		font-weight: 900;
		letter-spacing: -0.055em;
		line-height: 1.05;
		overflow-wrap: anywhere;
	}

	.about-bio {
		margin: 0;
		color: rgb(234 220 246 / 0.78);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		line-height: 1.8;
		word-break: keep-all;
		overflow-wrap: anywhere;
	}

	.about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.about-link {
		min-height: 44px;
		gap: 0.65rem;
		padding: 0.8rem 1.05rem;
		border: 1px solid rgb(216 177 248 / 0.22);
		border-radius: 0.75rem;
		color: rgb(249 240 255 / 0.9);
		background: rgb(177 110 235 / 0.09);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.about-link:hover {
		border-color: rgb(225 190 255 / 0.5);
		background: rgb(177 110 235 / 0.18);
	}

	.about-link-arrow {
		width: 0.9rem;
		height: 0.9rem;
		margin-left: 0.25rem;
		color: rgb(205 164 241 / 0.7);
	}

	.about-page a:focus-visible {
		outline: 2px solid #d3a4fc;
		outline-offset: 5px;
	}

	.about-scroll-cue {
		position: absolute;
		inset: auto 0 1.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		width: fit-content;
		min-height: 44px;
		margin-inline: auto;
		color: rgb(216 194 233 / 0.65);
		font-size: 0.7rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.about-scroll-cue::before {
		content: "";
		width: 2.5rem;
		height: 1px;
		background: rgb(202 152 244 / 0.45);
	}

	.about-scroll-cue:hover {
		color: #e4c4ff;
	}

	.about-overview {
		width: min(100%, 70rem);
		margin-inline: auto;
		padding-block: 5rem;
	}

	.about-overview-inner {
		width: 100%;
	}

	.about-overview h2 {
		margin: 0.8rem 0 1.5rem;
		font-size: clamp(2.75rem, 6vw, 5rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.15;
	}

	.about-introduction {
		max-width: 40rem;
		margin: 0;
		color: rgb(234 220 246 / 0.8);
		font-size: clamp(1.1rem, 1.8vw, 1.45rem);
		line-height: 1.9;
		word-break: keep-all;
		overflow-wrap: anywhere;
	}

	.about-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		margin-top: 3.5rem;
	}

	.about-stat-card {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.7rem;
		min-width: 0;
		padding: 1.6rem;
		border: 1px solid rgb(199 150 244 / 0.15);
		border-radius: 1rem;
		background: linear-gradient(140deg, rgb(172 106 227 / 0.08), rgb(255 255 255 / 0.015));
	}

	.about-stat-icon {
		grid-area: 1 / 2;
		align-self: center;
		width: 1.5rem;
		height: 1.5rem;
		color: #b789db;
	}

	.about-stat-value {
		grid-area: 1 / 1;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.15;
	}

	.about-stat-label {
		grid-column: 1 / -1;
		color: rgb(222 201 239 / 0.65);
		font-size: 0.8rem;
	}

	.about-content {
		width: min(calc(100% - 3rem), 70rem);
		margin-inline: auto;
		padding-block: 2rem 7rem;
		scroll-margin-top: calc(var(--about-nav-height) + 1rem);
	}

	.about-timeline-section {
		display: grid;
		grid-template-columns: 13rem minmax(0, 1fr);
		align-items: start;
		gap: clamp(2rem, 5vw, 5rem);
		padding-block: 3rem;
		border-top: 1px solid rgb(201 158 238 / 0.17);
	}

	.about-section-heading {
		position: sticky;
		top: calc(var(--about-nav-height) + 2rem);
	}

	.about-section-number {
		color: #b789db;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
	}

	.about-section-heading h2 {
		margin-top: 0.8rem;
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.3;
	}

	.about-page .about-timeline .tl {
		min-width: 0;
		margin-top: 0;
	}

	.about-page .about-timeline .body {
		margin-bottom: 1rem;
		padding: 1rem 1.15rem;
	}

	.about-page .about-timeline .title {
		font-size: 1.05rem;
		overflow-wrap: anywhere;
	}

	.about-page .about-timeline .sub {
		flex-wrap: wrap;
		border-radius: 0.6rem;
		line-height: 1.5;
	}

	.about-page .about-timeline .sub-note {
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.about-page .about-timeline .period {
		overflow-wrap: anywhere;
	}

	/* The document supplies the scroll distance; only these two scenes are pinned. */
	@media (min-width: 900px) and (min-height: 620px) and (prefers-reduced-motion: no-preference) {
		.about-page[data-motion="scroll"] .about-story {
			height: calc(190svh - var(--about-nav-height));
		}

		.about-page[data-motion="scroll"] .about-stage {
			position: sticky;
			top: var(--about-nav-height);
			display: grid;
			height: calc(100svh - var(--about-nav-height));
		}

		.about-page[data-motion="scroll"] .about-hero,
		.about-page[data-motion="scroll"] .about-overview {
			grid-area: 1 / 1;
			min-height: 0;
			height: 100%;
			will-change: opacity, transform;
		}

		.about-page[data-motion="scroll"] .about-overview {
			display: flex;
			align-items: center;
			padding-block: 2rem 4rem;
		}
	}

	@media (max-width: 899px) {
		.about-hero {
			grid-template-columns: minmax(0, 1fr);
			justify-items: center;
			align-content: center;
			gap: 3rem;
			padding-block: 3rem 7rem;
			text-align: center;
		}

		.about-avatar {
			width: min(17rem, 58vw);
		}

		.about-copy {
			width: 100%;
			max-width: 32rem;
		}

		.about-copy h1 {
			margin-block: 0.9rem 1.1rem;
			font-size: clamp(3.5rem, 13vw, 5rem);
		}

		.about-kicker {
			font-size: 0.7rem;
			letter-spacing: 0.1em;
		}

		.about-actions {
			justify-content: center;
			margin-top: 1.6rem;
		}

		.about-overview {
			padding-block: 3rem;
		}

		.about-stats {
			gap: 0.7rem;
			margin-top: 2rem;
		}

		.about-stat-card {
			grid-template-columns: 1fr;
			gap: 0.5rem;
			padding: 1rem 0.85rem;
		}

		.about-stat-icon {
			grid-area: auto;
			margin-bottom: 0.3rem;
		}

		.about-stat-value {
			grid-area: auto;
			font-size: clamp(1.8rem, 6vw, 2.5rem);
		}

		.about-timeline-section {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
			padding-block: 2rem;
		}

		.about-section-heading {
			position: static;
		}

		.about-section-heading h2 {
			margin-top: 0.4rem;
		}

		.about-page .about-timeline .body {
			padding: 0.9rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-page *,
		.about-page *::before,
		.about-page *::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
