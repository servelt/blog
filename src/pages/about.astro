---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)} hideSidebar={true} flowContent={true}>
		<div class="about-page">
			<section class="about-content">
				<div class="about-mainbox card-base overflow-hidden is-expanded">
					<div class="about-mainbox-glow" aria-hidden="true"></div>
					<div class="about-avatar">
						<ImageWrapper src={profileConfig.avatar || ""} alt="Profile Image of the Author" class="h-full w-full"></ImageWrapper>
					</div>
					<div class="about-copy">
						<div class="about-kicker">Security / CTF / Development</div>
						<h1>{profileConfig.name}</h1>
						<p>{profileConfig.bio}</p>
						<div class="about-actions">
							{profileConfig.links.map((item) => (
								<a href={item.url} target="_blank" rel="noopener noreferrer" class="btn-regular about-link">
									{item.icon && <Icon name={item.icon} class="text-[1.25rem]"></Icon>}
									<span>{item.name}</span>
								</a>
							))}
						</div>
					</div>
				</div>
				<div class="about-live-stack">
					<section class="about-stats" aria-label="Blog stats">
						{aboutStats.map((item) => (
							<div class="about-stat-card">
								<div class="about-stat-icon">
									<Icon name={item.icon} class="text-[1.45rem]"></Icon>
								</div>
								<div>
									<div class="about-stat-value">{item.value}</div>
									<div class="about-stat-label">{item.label}</div>
								</div>
							</div>
						))}
					</section>
					<section class="about-intro-card">
						<h2>About Me</h2>
						<p>보안, 개발을 공부하고 있는 고등학생 Servelt라고 합니다!</p>
					</section>
					<section class="about-achievements about-timeline">
						{timelineSections.map((section) => (
							<section class="about-timeline-section">
								<h2>{section.title}</h2>
								<Timeline entries={section.entries}></Timeline>
							</section>
						))}
					</section>
				</div>
			</section>
		</div>
	</MainGridLayout>

<style is:global>
	.about-page {
		--about-main-left: 0px;
		--about-main-top: 0px;
		--about-main-width: 100vw;
		--about-main-height: 100vh;
		--about-main-radius: 0rem;
		--about-main-padding: clamp(1.7rem, 5vw, 4.6rem);
		--about-main-tilt: -1.2deg;
		--about-main-scale: 1.006;
		--about-main-glow-opacity: 0.9;
		--about-main-glow-scale: 1.14;
		--about-content-width: min(calc(100vw - 2rem), var(--page-width));
		--about-content-top: 5.5rem;
		--about-content-opacity: 1;
		--about-content-y: 0px;
		--about-live-left: max(1rem, calc((100vw - min(calc(100vw - 2rem), var(--page-width))) / 2));
		--about-live-top: 28rem;
		--about-live-width: min(calc(100vw - 2rem), var(--page-width));
		--about-live-height: 42vh;
		--about-live-opacity: 1;
		--about-live-y: 0px;
		--about-live-scale: 1;
		--about-compact-height: 16rem;
		width: 100vw;
		min-height: 100vh;
		margin-top: -5.5rem;
		margin-left: calc(50% - 50vw);
		padding: 5.5rem 0 5.5rem;
		overflow-x: clip;
		background:
			radial-gradient(circle at 16% 18%, rgba(217, 170, 255, 0.16), transparent 28rem),
			radial-gradient(circle at 78% 16%, rgba(184, 90, 255, 0.13), transparent 27rem),
			radial-gradient(circle at 58% 74%, rgba(128, 52, 220, 0.14), transparent 34rem),
			linear-gradient(180deg, rgb(5 3 10), rgb(9 5 18) 44%, rgb(4 3 8));
	}

	html:has(.about-page) #top-row,
	.about-motion-page #top-row {
		position: fixed;
		inset: 0 0 auto;
		z-index: 80;
	}

	html.about-scroll-jacking,
	html.about-scroll-jacking body {
		height: 100%;
		overflow: hidden !important;
		overscroll-behavior: none;
	}

	html.about-scroll-jacking[data-overlayscrollbars-viewport],
	html.about-scroll-jacking [data-overlayscrollbars-viewport] {
		--os-viewport-overflow-x: hidden !important;
		--os-viewport-overflow-y: hidden !important;
		overflow: hidden !important;
		overscroll-behavior: none !important;
		touch-action: none !important;
	}

	.about-content {
		position: relative;
		z-index: 8;
		width: var(--about-content-width);
		max-width: calc(100vw - 1.5rem);
		margin: var(--about-content-top) auto 0;
		padding-bottom: 6rem;
		opacity: var(--about-content-opacity);
		transform: translate3d(0, var(--about-content-y), 0);
		transition:
			opacity 260ms cubic-bezier(0.16, 0.84, 0.2, 1),
			transform 260ms cubic-bezier(0.16, 0.84, 0.2, 1);
		will-change: opacity, transform;
	}

	.about-motion-running .about-content {
		width: 100vw;
		max-width: 100vw;
		margin: 0;
		padding: 0;
		opacity: 1;
		transform: none;
	}

	.about-mainbox {
		position: relative;
		z-index: 10;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(11rem, 12rem) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.35rem, 3vw, 2.25rem);
		width: 100%;
		height: var(--about-compact-height);
		min-height: var(--about-compact-height);
		padding: 1.65rem;
		border-radius: 1rem;
		border-color: rgba(228, 202, 255, 0.2);
		background:
			radial-gradient(circle at 86% 10%, rgba(171, 83, 255, 0.28), transparent 22rem),
			radial-gradient(circle at 9% 92%, rgba(162, 100, 255, 0.13), transparent 18rem),
			linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(118, 45, 186, 0.1) 34%, rgba(8, 5, 14, 0.74)),
			rgba(17, 10, 28, 0.92);
		box-shadow:
			0 1.35rem 4.6rem -3.2rem rgba(205, 132, 255, 0.8),
			inset 0 1px 0 rgba(255, 255, 255, 0.12);
		pointer-events: auto;
		transform-origin: center top;
		transform-style: preserve-3d;
		will-change: transform;
	}

	.about-motion-running .about-mainbox {
		position: fixed;
		left: var(--about-main-left);
		top: var(--about-main-top);
		z-index: 100;
		width: var(--about-main-width);
		height: var(--about-main-height);
		min-height: 0;
		max-width: 100vw;
		padding: var(--about-main-padding);
		border-radius: var(--about-main-radius);
		transform:
			translateZ(0)
			rotateX(var(--about-main-tilt))
			scale(var(--about-main-scale));
		transition:
			left 220ms cubic-bezier(0.16, 0.84, 0.2, 1),
			top 220ms cubic-bezier(0.16, 0.84, 0.2, 1),
			width 220ms cubic-bezier(0.16, 0.84, 0.2, 1),
			height 220ms cubic-bezier(0.16, 0.84, 0.2, 1),
			border-radius 220ms cubic-bezier(0.16, 0.84, 0.2, 1),
			padding 220ms cubic-bezier(0.16, 0.84, 0.2, 1),
			transform 220ms cubic-bezier(0.16, 0.84, 0.2, 1);
		will-change: left, top, width, height, border-radius, padding, transform;
	}

	.about-motion-running .about-mainbox.is-expanded {
		border: 1px solid rgba(238, 218, 255, 0.14);
		background:
			linear-gradient(110deg, rgba(184, 90, 255, 0.13), transparent 30%),
			radial-gradient(circle at 29% 47%, rgba(217, 170, 255, 0.2), transparent 23rem),
			radial-gradient(circle at 66% 38%, rgba(151, 70, 255, 0.2), transparent 27rem),
			radial-gradient(circle at 78% 78%, rgba(230, 170, 255, 0.1), transparent 26rem),
			linear-gradient(180deg, rgba(8, 4, 16, 0.99), rgba(6, 4, 13, 0.99) 52%, rgba(3, 2, 7, 0.995));
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.03),
			0 0 6rem rgba(184, 88, 255, 0.24),
			0 2.4rem 8.6rem -4rem rgba(224, 184, 255, 0.64),
			inset 0 1px 0 rgba(255, 255, 255, 0.09),
			inset 0 -7rem 12rem rgba(52, 18, 92, 0.32);
	}

	.about-motion-running .about-mainbox.is-expanded::before,
	.about-motion-running .about-mainbox.is-expanded::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
	}

	.about-motion-running .about-mainbox.is-expanded::before {
		z-index: 1;
		background:
			radial-gradient(circle, rgba(248, 232, 255, 0.68) 0 1px, transparent 1.8px) 12% 18% / 9rem 9rem,
			radial-gradient(circle, rgba(205, 132, 255, 0.5) 0 1px, transparent 1.7px) 72% 24% / 12rem 12rem,
			radial-gradient(circle, rgba(232, 202, 255, 0.34) 0 1px, transparent 1.6px) 48% 78% / 10rem 10rem,
			linear-gradient(115deg, transparent 0 33%, rgba(255, 255, 255, 0.1) 47%, transparent 61%),
			repeating-linear-gradient(90deg, rgba(230, 202, 255, 0.04) 0 1px, transparent 1px 8.4rem),
			repeating-linear-gradient(0deg, rgba(230, 202, 255, 0.026) 0 1px, transparent 1px 8.4rem);
		mask-image: linear-gradient(90deg, black, rgba(0, 0, 0, 0.68) 58%, transparent 94%);
		opacity: 0.42;
	}

	.about-motion-running .about-mainbox.is-expanded::after {
		z-index: 1;
		inset: 1px;
		background:
			linear-gradient(127deg, transparent 0 53%, rgba(205, 132, 255, 0.13) 53.2%, transparent 53.7% 100%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 24%),
			radial-gradient(circle at 67% 48%, transparent 0 16rem, rgba(2, 2, 6, 0.44) 42rem);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.046);
	}

	.about-motion-running .about-mainbox.is-expanded {
		grid-template-columns: minmax(18rem, 30rem) minmax(22rem, 35rem);
		grid-template-rows: auto;
		justify-content: center;
		justify-items: stretch;
		align-items: center;
		align-content: center;
		gap: clamp(2.5rem, 6vw, 6.6rem);
	}

	.about-mainbox:not(.is-expanded) {
		grid-template-columns: minmax(11rem, 12rem) minmax(0, 1fr);
		justify-content: stretch;
		justify-items: stretch;
		align-content: center;
		align-items: center;
		gap: clamp(1.5rem, 3vw, 2rem);
		border: 1px solid rgba(228, 202, 255, 0.2);
		background:
			radial-gradient(circle at 86% 10%, rgba(171, 83, 255, 0.28), transparent 22rem),
			radial-gradient(circle at 9% 92%, rgba(162, 100, 255, 0.13), transparent 18rem),
			linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(118, 45, 186, 0.1) 34%, rgba(8, 5, 14, 0.74)),
			rgba(17, 10, 28, 0.92);
		box-shadow:
			0 1.35rem 4.6rem -3.2rem rgba(205, 132, 255, 0.8),
			inset 0 1px 0 rgba(255, 255, 255, 0.12);
	}

	.about-mainbox:not(.is-expanded) .about-mainbox-glow {
		width: 18rem;
		height: 18rem;
		left: 18%;
		top: 52%;
		opacity: 0.18;
		filter: blur(4.5rem);
		transform: translate(-50%, -50%) scale(0.82);
	}

	.about-mainbox:not(.is-expanded) .about-avatar {
		justify-self: start;
		width: min(12rem, 100%);
		border-radius: 1rem;
	}

	.about-mainbox:not(.is-expanded) .about-copy {
		align-items: flex-start;
		max-width: none;
		text-align: left;
	}

	.about-mainbox:not(.is-expanded) .about-kicker {
		margin-inline: 0;
	}

	.about-mainbox:not(.is-expanded) .about-actions {
		justify-content: flex-start;
	}

	.about-motion-running .about-mainbox.is-expanded .about-mainbox-glow {
		width: clamp(34rem, 70vmin, 54rem);
		height: clamp(30rem, 68vmin, 52rem);
		left: 37%;
		top: 50%;
		background:
			radial-gradient(circle at 44% 46%, rgba(255, 255, 255, 0.36), rgba(226, 190, 255, 0.25) 24%, rgba(184, 90, 255, 0.18) 48%, transparent 74%),
			conic-gradient(from 210deg, transparent, rgba(232, 202, 255, 0.28), transparent 36%, rgba(174, 88, 255, 0.2), transparent 70%);
		filter: blur(6.5rem) saturate(1.28);
		mix-blend-mode: screen;
		opacity: var(--about-main-glow-opacity);
		transform: translate(-50%, -50%) scale(var(--about-main-glow-scale));
	}

	.about-motion-running .about-mainbox.is-expanded .about-avatar {
		width: clamp(17.5rem, 30vw, 27rem);
		aspect-ratio: 1.04;
		padding: 0.42rem;
		border-radius: 1.35rem;
		border: 1px solid rgba(250, 236, 255, 0.38);
		background:
			radial-gradient(circle at 26% 16%, rgba(255, 255, 255, 0.2), transparent 18%),
			conic-gradient(from 238deg, rgba(251, 239, 255, 0.72), rgba(184, 90, 255, 0.16), rgba(255, 255, 255, 0.12), rgba(136, 57, 231, 0.42), rgba(251, 239, 255, 0.72)),
			linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(211, 150, 255, 0.2) 32%, rgba(45, 17, 78, 0.38) 68%),
			rgba(9, 5, 17, 0.92);
		box-shadow:
			0 0 0 0.52rem rgba(180, 92, 255, 0.06),
			0 0 0 1.08rem rgba(255, 255, 255, 0.02),
			0 2.2rem 5.8rem -2.7rem rgba(224, 184, 255, 0.72),
			0 0 5.2rem rgba(190, 116, 255, 0.48),
			0 0 9rem rgba(143, 54, 255, 0.26),
			inset 0 1px 0 rgba(255, 255, 255, 0.22);
	}

	.about-motion-running .about-mainbox.is-expanded .about-avatar > div {
		border-radius: 0.95rem;
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.08),
			inset 0 -2.6rem 4rem rgba(13, 4, 25, 0.28);
	}

	.about-motion-running .about-mainbox.is-expanded .about-avatar::before,
	.about-motion-running .about-mainbox.is-expanded .about-avatar::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
		pointer-events: none;
	}

	.about-motion-running .about-mainbox.is-expanded .about-avatar::before {
		padding: 0;
		background:
			linear-gradient(90deg, rgba(250, 238, 255, 0.78) 0 3.7rem, transparent 0 calc(100% - 3.7rem), rgba(205, 132, 255, 0.58) 0) 50% 0.9rem / calc(100% - 1.8rem) 1px no-repeat,
