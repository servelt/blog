---
import path from "node:path";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const { remarkPluginFrontmatter } = await entry.render();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} hideSidebar={true} hideToc={true}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="post-shell">
        <article id="post-container" class="post-article">
            <header class="post-hero onload-animation">
                <div class="post-hero-inner">
                    <div class="post-topline">
                        <span class="post-pill">
                            <Icon name="material-symbols:notes-rounded"></Icon>
                            {remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}
                        </span>
                        <span class="post-pill">
                            <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                            {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                        </span>
                    </div>

                    <h1
                        data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                        class="post-title">
                        {entry.data.title}
                    </h1>

                    {entry.data.description && <p class="post-description">{entry.data.description}</p>}

                    <PostMetadata
                            class="post-meta-panel"
                            published={entry.data.published}
                            updated={entry.data.updated}
                            tags={entry.data.tags}
                            category={entry.data.category}
                    ></PostMetadata>
                </div>
            </header>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} class="post-cover banner-container onload-animation"/>
            }


            <div class="post-reading-shell">
                <div class="post-reading-rail" aria-hidden="true"></div>
                <Markdown class="markdown-content onload-animation">
                    <Content />
                </Markdown>
            </div>
        </article>
    </div>

    <div class="post-neighbor-nav">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["post-neighbor-link", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="post-neighbor-card prev-post" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div>
                    <span>Previous</span>
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["post-neighbor-link", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="post-neighbor-card next-post">
                <div>
                    <span>Next</span>
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>

</MainGridLayout>

<style is:global>
    .post-shell {
        position: relative;
        isolation: isolate;
        width: 100%;
        margin-bottom: 2.2rem;
    }

    .post-shell::before {
        content: "";
        position: absolute;
        inset: -7rem -4rem auto;
        z-index: -1;
        height: 34rem;
        background:
            radial-gradient(circle at 14% 2%, rgba(198, 132, 255, 0.18), transparent 20rem),
            radial-gradient(circle at 84% 10%, rgba(232, 202, 255, 0.11), transparent 23rem),
            linear-gradient(180deg, rgba(198, 132, 255, 0.075), transparent 72%);
        pointer-events: none;
    }

    .post-article {
        position: relative;
        z-index: 1;
        isolation: isolate;
        width: 100%;
        color: rgb(244 239 250 / 0.9);
    }

    .post-hero {
        position: relative;
        overflow: hidden;
        min-height: clamp(18rem, 44vh, 27rem);
        margin: 0 0 clamp(2rem, 5vw, 3.8rem);
        border-bottom: 1px solid rgba(198, 132, 255, 0.16);
        padding:
            clamp(1.6rem, 5vw, 3.2rem)
            clamp(1.05rem, 3.4vw, 2.4rem)
            clamp(2rem, 5vw, 3.4rem);
    }

    .post-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(90deg, rgba(198, 132, 255, 0.15), transparent 58%),
            radial-gradient(circle at 20% 28%, rgba(224, 188, 255, 0.18), transparent 18rem);
        mask-image: linear-gradient(180deg, black 0 82%, transparent);
        pointer-events: none;
    }

    .post-hero::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        width: min(36rem, 78%);
        height: 1px;
        background: linear-gradient(90deg, rgba(249, 238, 255, 0.88), rgba(198, 132, 255, 0.5), transparent);
        box-shadow:
            0 0 1.2rem rgba(232, 202, 255, 0.42),
            0 0 3rem rgba(172, 92, 255, 0.22);
    }

    .post-hero-inner {
        max-width: 68rem;
    }

    .post-topline {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: clamp(1.2rem, 3vw, 2rem);
    }

    .post-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        min-height: 2.05rem;
        border: 1px solid rgba(224, 188, 255, 0.2);
        border-radius: 999rem;
        padding: 0 0.76rem;
        color: rgb(238 222 255 / 0.74);
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.065), rgba(198, 132, 255, 0.09)),
            rgba(8, 5, 16, 0.58);
        font-size: 0.76rem;
        font-weight: 860;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.04),
            0 0 1.4rem rgba(198, 132, 255, 0.09);
    }

    .post-pill svg {
        color: rgb(225 196 255 / 0.96);
        font-size: 1.05rem;
    }

    .post-title {
        max-width: 68rem;
        margin: 0;
        color: rgb(255 255 255 / 0.97);
        font-size: clamp(2.55rem, 5.4vw, 4.85rem);
        font-weight: 950;
        line-height: 0.98;
        letter-spacing: 0;
        text-wrap: balance;
        text-shadow:
            0 0 1.4rem rgba(224, 188, 255, 0.2),
            0 0 4.6rem rgba(176, 92, 255, 0.28);
    }

    .post-description {
        max-width: 62rem;
        margin: 1.15rem 0 0;
        color: rgb(238 222 255 / 0.72);
        font-size: clamp(1.02rem, 1.5vw, 1.16rem);
        line-height: 1.76;
    }

    .post-meta-panel {
        max-width: 60rem;
        margin-top: clamp(1.35rem, 3vw, 2rem);
        gap: 0.55rem !important;
        color: rgb(232 216 255 / 0.58) !important;
    }

    .post-meta-panel > div {
        min-height: 2.35rem;
        border: 1px solid rgba(198, 132, 255, 0.14);
        border-radius: 999rem;
        padding: 0.18rem 0.72rem 0.18rem 0.2rem;
        background: rgba(13, 8, 22, 0.66);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
    }

    .post-meta-panel .meta-icon {
        width: 1.92rem;
        height: 1.92rem;
        border-radius: 999rem;
        background: rgba(151, 90, 230, 0.2);
        color: rgb(224 188 255 / 0.92);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.05),
            0 0 1rem rgba(198, 132, 255, 0.1);
    }

    .post-meta-panel a,
    .post-meta-panel span {
        color: rgb(238 222 255 / 0.72) !important;
    }

    .post-meta-panel a:hover {
        color: rgb(255 255 255 / 0.98) !important;
    }

    .post-cover {
        display: block;
        max-width: min(100%, 72rem);
        margin: 0 auto clamp(2rem, 5vw, 3.4rem);
        overflow: hidden;
        border: 1px solid rgba(198, 132, 255, 0.18);
        border-radius: 0.95rem;
        box-shadow:
            0 1.3rem 4.8rem -3.4rem rgba(198, 132, 255, 0.8),
            inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .post-reading-shell {
        position: relative;
        display: grid;
        grid-template-columns: 0.75rem minmax(0, 68rem);
        justify-content: center;
        gap: clamp(0.85rem, 2vw, 1.25rem);
        width: min(100%, 72rem);
        max-width: min(100%, 72rem);
        margin-inline: auto;
    }

    .post-reading-rail {
        position: sticky;
        top: 6rem;
        align-self: start;
        width: 2px;
        height: min(38vh, 21rem);
        border-radius: 999rem;
        background:
            linear-gradient(180deg, rgba(249, 238, 255, 0.8), rgba(198, 132, 255, 0.44), transparent);
        box-shadow:
            0 0 0.9rem rgba(232, 202, 255, 0.45),
            0 0 2.2rem rgba(172, 92, 255, 0.28);
    }

    .post-article .markdown-content {
        width: 100%;
        max-width: 68rem !important;
        min-width: 0;
        margin: 0;
        color: rgb(242 236 248 / 0.88);
        font-family: "Roboto", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", "Noto Sans CJK KR", system-ui, sans-serif;
        font-size: clamp(1.02rem, 1.13vw, 1.1rem);
        line-height: 1.92;
        letter-spacing: 0;
        overflow-wrap: anywhere;
    }

    .post-article .markdown-content > :first-child {
        margin-top: 0;
    }

    .post-article .markdown-content p {
        margin: 1.16rem 0;
        color: rgb(242 236 248 / 0.88);
    }

    .post-article .markdown-content ul,
    .post-article .markdown-content ol {
        margin: 1.25rem 0;
        padding-left: 1.45rem;
    }

    .post-article .markdown-content li {
        margin: 0.34rem 0;
        color: rgb(242 236 248 / 0.88);
        padding-left: 0.18rem;
    }

    .post-article .markdown-content li::marker {
        color: rgb(224 188 255 / 0.9);
        font-weight: 800;
    }

    .post-article .markdown-content h1,
    .post-article .markdown-content h2,
    .post-article .markdown-content h3,
    .post-article .markdown-content h4 {
        scroll-margin-top: 6rem;
        color: rgb(255 255 255 / 0.96);
        letter-spacing: 0;
        text-shadow:
            0 0 1rem rgba(224, 188, 255, 0.16),
            0 0 2.6rem rgba(176, 92, 255, 0.18);
    }

    .post-article .markdown-content h2 {
        position: relative;
        margin-top: 3.25rem;
        margin-bottom: 1rem;
        border-top: 1px solid rgba(198, 132, 255, 0.16);
        padding-top: 1.18rem;
        font-size: clamp(1.65rem, 3.2vw, 2.25rem);
        line-height: 1.18;
    }

    .post-article .markdown-content h2::before {
        content: "";
        position: absolute;
        left: 0;
        top: -1px;
        width: min(11rem, 46%);
        height: 1px;
        background: linear-gradient(90deg, rgba(249, 238, 255, 0.86), rgba(198, 132, 255, 0.48), transparent);
        box-shadow: 0 0 1rem rgba(198, 132, 255, 0.36);
    }

    .post-article .markdown-content h3 {
        margin-top: 2.25rem;
        margin-bottom: 0.7rem;
        font-size: clamp(1.28rem, 2.1vw, 1.56rem);
        line-height: 1.28;
    }

    .post-article .markdown-content h3::before {
        content: "";
        display: inline-block;
        width: 0.42rem;
        height: 0.42rem;
        margin-right: 0.58rem;
        border-radius: 999rem;
        background: rgb(224 188 255);
        box-shadow: 0 0 1.1rem rgba(198, 132, 255, 0.68);
        transform: translateY(-0.08em);
    }

    .post-article .markdown-content h4 {
        margin-top: 1.9rem;
        color: rgb(238 222 255 / 0.92);
        font-size: 1.08rem;
    }

    .post-article .markdown-content a:not(.no-styling) {
        color: rgb(232 202 255 / 0.98);
        text-decoration-color: rgba(198, 132, 255, 0.45);
        text-underline-offset: 0.28em;
    }

    .post-article .markdown-content a:not(.no-styling):hover {
        background: rgba(198, 132, 255, 0.12);
        color: rgb(255 255 255 / 0.98);
    }

    .post-article .markdown-content blockquote {
        margin: 1.8rem 0;
        border: 1px solid rgba(198, 132, 255, 0.17);
        border-left: 2px solid rgba(224, 188, 255, 0.86);
        border-radius: 0.85rem;
        padding: 1rem 1.15rem 1rem 1.3rem;
        color: rgb(249 242 255 / 0.86);
        background:
            linear-gradient(90deg, rgba(198, 132, 255, 0.12), rgba(255, 255, 255, 0.022)),
            rgba(8, 5, 16, 0.7);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.035),
            0 1rem 3rem -2.6rem rgba(198, 132, 255, 0.55);
    }

    .post-article .markdown-content blockquote::before {
        display: none !important;
    }

    .post-article .markdown-content blockquote p {
        margin: 0.45rem 0;
    }

    .post-article .markdown-content :not(pre) > code {
        border: 1px solid rgba(198, 132, 255, 0.18);
        border-radius: 0.42rem;
        padding: 0.12rem 0.38rem;
        color: rgb(246 229 255 / 0.96);
        background: rgba(198, 132, 255, 0.1);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
    }

    .post-article .markdown-content .expressive-code {
        width: min(100%, calc(100vw - 2rem));
        margin: 1.85rem 0;
    }

    .post-article .markdown-content .expressive-code .frame {
        overflow: hidden;
        border: 1px solid rgba(198, 132, 255, 0.16);
        border-radius: 0.9rem;
        background: rgb(7 4 12);
        box-shadow:
            0 1.4rem 4.6rem -3.2rem rgba(198, 132, 255, 0.74),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .post-article .markdown-content .expressive-code pre {
        font-size: 0.92rem;
        line-height: 1.72;
    }

    .post-article .markdown-content .copy-btn {
        background: rgba(36, 20, 58, 0.94);
        color: rgb(246 229 255 / 0.9);
    }

    .post-article .markdown-content table {
        display: block;
        width: 100%;
        overflow-x: auto;
        border: 1px solid rgba(198, 132, 255, 0.14);
        border-radius: 0.85rem;
        margin: 1.8rem 0;
        background: rgba(8, 5, 16, 0.68);
    }

    .post-article .markdown-content th,
    .post-article .markdown-content td {
        border-color: rgba(198, 132, 255, 0.13);
        padding: 0.72rem 0.86rem;
    }

    .post-article .markdown-content th {
        color: rgb(255 255 255 / 0.94);
        background: rgba(198, 132, 255, 0.09);
    }

    .post-article .markdown-content img {
        border: 1px solid rgba(198, 132, 255, 0.14);
        border-radius: 0.9rem;
        box-shadow: 0 1.2rem 4rem -3.2rem rgba(198, 132, 255, 0.62);
    }

    .post-article .markdown-content hr {
        margin: 2.6rem 0;
        border: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(198, 132, 255, 0.38), transparent);
    }

    .post-neighbor-nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
        width: 100%;
        margin-bottom: 1.8rem;
    }

    .post-neighbor-link {
        min-width: 0;
        color: inherit;
        text-decoration: none;
    }

    .post-neighbor-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-height: 4.35rem;
        border: 1px solid rgba(198, 132, 255, 0.14);
        border-radius: 0.9rem;
        padding: 0.75rem 0.95rem;
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.035), rgba(198, 132, 255, 0.052)),
            rgba(8, 5, 16, 0.72);
        color: rgb(245 238 255 / 0.82);
        font-weight: 850;
        line-height: 1.25;
        transition:
            transform 0.18s ease,
            border-color 0.18s ease,
            background 0.18s ease,
            box-shadow 0.18s ease;
    }

    .post-neighbor-card span {
        display: block;
        margin-bottom: 0.16rem;
        color: rgb(232 216 255 / 0.5);
        font-size: 0.72rem;
        font-weight: 900;
    }

    .post-neighbor-card > div {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .post-neighbor-card.next-post {
        justify-content: flex-end;
        text-align: right;
    }

    .post-neighbor-link:hover .post-neighbor-card {
        transform: translateY(-2px);
        border-color: rgba(224, 188, 255, 0.34);
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.055), rgba(198, 132, 255, 0.09)),
            rgba(11, 7, 18, 0.84);
        box-shadow: 0 1.1rem 3.4rem -2.8rem rgba(198, 132, 255, 0.85);
    }

    @media (max-width: 768px) {
        .post-hero {
            min-height: auto;
            padding: 1.35rem 0 2rem;
        }

        .post-title {
            font-size: clamp(2rem, 12vw, 3.25rem);
            line-height: 1.04;
        }

        .post-meta-panel > div {
            width: 100%;
            border-radius: 0.8rem;
        }

        .post-reading-shell {
            display: block;
            max-width: none;
        }

        .post-reading-rail {
            display: none;
        }

        .post-article .markdown-content {
            max-width: none !important;
            font-size: 1rem;
            line-height: 1.82;
        }

        .post-article .markdown-content h2 {
            margin-top: 2.55rem;
            font-size: 1.55rem;
        }

        .post-neighbor-nav {
            grid-template-columns: 1fr;
        }
    }
</style>
